def build_svg(spec, width, radius, font, scale=1.0):
    """One button, drawn edge to edge so we own every pixel of it."""
    if spec.get("goal_scene"):
        return build_goal_svg(spec, width, font)
    label = html.escape(spec.get("label", ""))
    size = spec.get("size", 26)
    caption = html.escape(str(spec.get("sub") or ""))
    gauge = spec.get("gauge")
    # Use essentially all 60 physical pixels. The old 48px pills looked like a
    # narrow toolbar floating inside the Touch Bar instead of owning it.
    pill_w, pill_h = width - 4, 58
    centre = "%.2f %.2f" % (width / 2, BAR_HEIGHT / 2)
    transform = (
        ' transform="translate(%s) scale(%.3f) translate(-%s)"' % (centre, scale, centre)
        if scale != 1.0
        else ""
    )
    gloss = ""
    if spec.get("gloss", True):
        gloss = (
            '<rect x="2" y="1" width="%.2f" height="%.2f" rx="%d" fill="url(#g)"/>'
            % (pill_w, pill_h / 2, radius)
        )
    badge = ""
    if spec.get("badge"):
        badge = (
            '<circle cx="%.2f" cy="13" r="9" fill="%s"/>'
            '<text x="%.2f" y="16.5" font-family="%s" font-size="11" '
            'font-weight="bold" fill="%s" text-anchor="middle">%s</text>'
            % (width - 15, spec.get("badge_fill", "#161616"), width - 15,
               font, spec.get("badge_fg", "#d4be98"),
               html.escape(str(spec["badge"])))
        )
    glow = ""
    shadow = ""
    if spec.get("glow"):
        glow = (
            '<filter id="halo" x="-30%" y="-60%" width="160%" height="220%">'
            '<feGaussianBlur stdDeviation="3" result="blur"/>'
            '<feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/>'
            '</feMerge></filter>'
        )
        shadow = ' filter="url(#halo)"'
    fg = spec.get("fg", "#d4be98")

    def text(y, body, px, colour):
        if not body:
            return ""
        return ('<text x="%.2f" y="%.2f" font-family="%s" font-size="%d" '
                'font-weight="bold" fill="%s" text-anchor="middle">%s</text>'
                % (width / 2, y, font, px, colour, body))

    favicon = spec.get("favicon")
    tab_title = str(spec.get("tab_title") or "")
    if favicon:
        compact_tab = bool(spec.get("tab_compact")) or width < 132
        icon_size = 34 if compact_tab else 30
        icon_x = (width - icon_size) / 2 if compact_tab else 15
        icon_y = (BAR_HEIGHT - icon_size) / 2
        body = (
            '<clipPath id="tabicon"><rect x="%.2f" y="%.2f" width="%d" height="%d" rx="6"/></clipPath>'
            '<image href="%s" x="%.2f" y="%.2f" width="%d" height="%d" '
            'preserveAspectRatio="xMidYMid meet" clip-path="url(#tabicon)"/>'
            % (icon_x, icon_y, icon_size, icon_size, html.escape(favicon, quote=True),
               icon_x, icon_y, icon_size, icon_size)
        )
        if not compact_tab and tab_title:
            text_left = icon_x + icon_size + 11
            text_right = width - (27 if spec.get("badge") else 12)
            capacity = max(3, int((text_right - text_left) / 10.2))
            shown = tab_title
            if len(shown) > capacity:
                loop = shown + "   ·   "
                offset = int(spec.get("marquee", 0)) % len(loop)
                shown = (loop + loop)[offset:offset + capacity]
            body += (
                '<clipPath id="tabtext"><rect x="%.2f" y="7" width="%.2f" height="46"/></clipPath>'
                '<text x="%.2f" y="37" font-family="%s" font-size="18" '
                'font-weight="bold" fill="%s" text-anchor="start" '
                'clip-path="url(#tabtext)">%s</text>'
                % (text_left, max(1.0, text_right - text_left), text_left, font,
                   fg, html.escape(shown))
            )
        if spec.get("tab_active"):
            body += ('<rect x="14" y="53" width="%.2f" height="3" rx="1.5" fill="%s"/>'
                     % (max(8.0, width - 28), fg))
    elif spec.get("tab_fallback"):
        body = text(BAR_HEIGHT / 2 + size * 0.36, label, size, fg)
    else:
        body = None

    waveform = spec.get("waveform")
    bars = spec.get("bars")
    if body is not None:
        pass
    elif waveform:
        # Voxtype provides the real minimum and maximum sample values for
        # every frame. Render their envelope so the waveform rises and falls
        # above and below the centre line instead of becoming flat dots.
        pad, centre, half_height = 22.0, BAR_HEIGHT / 2.0, 23.0
        count = len(waveform)
        step = (width - pad * 2) / max(1, count - 1)
        upper, lower = [], []
        for index, (minimum, maximum) in enumerate(waveform):
            x = pad + index * step
            low = max(-1.0, min(0.0, float(minimum)))
            high = min(1.0, max(0.0, float(maximum)))
            upper.append((x, centre - high * half_height))
            lower.append((x, centre - low * half_height))
        upper_points = " ".join("%.2f,%.2f" % point for point in upper)
        lower_points = " ".join("%.2f,%.2f" % point for point in lower)
        envelope = upper_points + " " + " ".join(
            "%.2f,%.2f" % point for point in reversed(lower))
        wave_color = spec.get("fg", "#d4be98")
        body = (
            '<line x1="%.2f" y1="%.2f" x2="%.2f" y2="%.2f" '
            'stroke="%s" stroke-width="1" opacity="0.22"/>'
            '<polygon points="%s" fill="%s" opacity="0.24"/>'
            '<polyline points="%s" fill="none" stroke="%s" '
            'stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>'
            '<polyline points="%s" fill="none" stroke="%s" '
            'stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>'
            % (pad, centre, width - pad, centre, wave_color, envelope,
               wave_color, upper_points, wave_color, lower_points, wave_color)
        )
    elif bars:
        count = len(bars)
        bar_w, gap = 7.0, 5.0
        span = count * bar_w + (count - 1) * gap
        left = (width - span) / 2.0
        tallest = 34.0
        body = ""
        for index, height in enumerate(bars):
            tall = max(5.0, tallest * float(height))
            body += ('<rect x="%.2f" y="%.2f" width="%.2f" height="%.2f" rx="3" '
                     'fill="%s"/>'
                     % (left + index * (bar_w + gap),
                        BAR_HEIGHT / 2 - tall / 2, bar_w, tall,
                        spec.get("fg", "#d4be98")))
    elif gauge is not None:
        pad, track_y, track_h = 16.0, 42.0, 8.0
        track_w = width - pad * 2
        filled = max(track_h, track_w * min(max(float(gauge), 0.0), 1.0))
        body = (
            text(26, label, size, fg)
            + text(38, caption, spec.get("sub_size", 13), spec.get("sub_fg", fg))
            + '<rect x="%.2f" y="%.2f" width="%.2f" height="%.2f" rx="%.2f" fill="%s"/>'
              % (pad, track_y, track_w, track_h, track_h / 2, spec.get("track", "#161616"))
            + '<rect x="%.2f" y="%.2f" width="%.2f" height="%.2f" rx="%.2f" fill="%s"/>'
              % (pad, track_y, filled, track_h, track_h / 2, spec.get("bar", fg))
        )
    elif caption:
        body = (text(29, label, size, fg)
                + text(47, caption, spec.get("sub_size", 14), spec.get("sub_fg", fg)))
    else:
        body = text(BAR_HEIGHT / 2 + size * 0.36, label, size, fg)

    return (
        '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" '
        'viewBox="0 0 %d %d">'
        '<defs><linearGradient id="g" x1="0" y1="0" x2="0" y2="1">'
        '<stop offset="0" stop-color="#ffffff" stop-opacity="0.10"/>'
        '<stop offset="1" stop-color="#ffffff" stop-opacity="0"/>'
        "</linearGradient>%s</defs>"
        '<g%s%s><rect x="2" y="1" width="%.2f" height="%.2f" rx="%d" fill="%s"/>%s'
        "%s%s</g></svg>"
        % (
            int(width), BAR_HEIGHT, int(width), BAR_HEIGHT,
            glow, transform, shadow, pill_w, pill_h, radius,
            spec.get("fill", "#3c3836"), gloss, body, badge,
        )
    )


class IconCache:
    """SVGs are content-addressed, so identical buttons reuse one file."""

    def __init__(self, clear=False):
        self.known = set()
        if clear:
            try:
                shutil.rmtree(GEN_DIR)
            except OSError:
                pass
        try:
            os.makedirs(GEN_DIR, exist_ok=True)
        except OSError as exc:
            sys.stderr.write("omarchy-touchbar: cannot create %s: %s\n" % (GEN_DIR, exc))

    def store(self, svg):
        digest = hashlib.sha1(svg.encode()).hexdigest()[:16]
        if digest not in self.known:
            try:
                with open(os.path.join(GEN_DIR, digest + ".svg"), "w") as handle:
                    handle.write(svg)
                self.known.add(digest)
            except OSError:
                return None
        return "gen/" + digest


# ------------------------------------------------------------ toml emission --
def toml_string(value):
    return '"%s"' % str(value).replace("\\", "\\\\").replace('"', '\\"')


def action_field(keys):
    names = parse_chord(keys) if isinstance(keys, str) else list(keys or [])
    if not names:
        return None
    if len(names) == 1:
        return "Action = %s" % toml_string(names[0])
    return "Action = [%s]" % ", ".join(toml_string(n) for n in names)


