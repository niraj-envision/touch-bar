class MediaState:
    """Whatever is playing, from MPRIS on the session bus.

    playerctl is not installed here, so this talks to the bus directly through
    busctl - the same interface playerctl would use.
    """

    def __init__(self):
        self.player = ""
        self.status = "Stopped"
        self.title = ""
        self.muted = False
        self.checked = 0.0

    def refresh(self, interval=1.5):
        now = time.monotonic()
        if now - self.checked < interval:
            return
        self.checked = now
        names = [n for n in run_quiet(["busctl", "--user", "list", "--no-pager"]).split()
                 if n.startswith("org.mpris.MediaPlayer2.")]
        chosen, status = "", "Stopped"
        for name in names:
            state = self._property(name, "PlaybackStatus")
            if state == "Playing":
                chosen, status = name, state
                break
            if state == "Paused" and not chosen:
                chosen, status = name, state
        self.player, self.status = chosen, status
        if chosen:                    # mute only matters while transport shows
            volume = run_quiet(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
            self.muted = "MUTED" in volume

    def _property(self, name, prop):
        out = run_quiet(["busctl", "--user", "get-property", name, MPRIS_PATH,
                         MPRIS_PLAYER, prop])
        parts = out.strip().split('"')
        return parts[1] if len(parts) > 1 else ""

    @property
    def active(self):
        return bool(self.player) and self.status in ("Playing", "Paused")

    @property
    def playing(self):
        return self.status == "Playing"

    def call(self, method):
        if self.player:
            run_quiet(["busctl", "--user", "call", self.player, MPRIS_PATH,
                       MPRIS_PLAYER, method])

    def toggle_mute(self):
        run_quiet(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"])
        self.checked = 0.0


def hwmon_by_name(name):
    """The /sys/class/hwmon entry whose chip name matches, if present."""
    for entry in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        for probe in (os.path.join(entry, "name"),
                      os.path.join(entry, "device", "name")):
            try:
                with open(probe) as handle:
                    if handle.read().strip() == name:
                        return entry
            except OSError:
                continue
    return None


def read_int(path):
    try:
        with open(path) as handle:
            return int(handle.read().strip())
    except (OSError, ValueError):
        return None


def human_kb(kb):
    return "%.1fG" % (kb / 1048576.0) if kb >= 1048576 else "%dM" % (kb // 1024)


class SystemStats:
    """Machine vitals and level controls, read as cheaply as possible.

    Everything on the system page comes straight from procfs/sysfs, so a poll
    costs microseconds. Only the volume readout shells out (wpctl), and only
    while the settings page is showing.
    """

    def __init__(self):
        self.checked = 0.0
        self.controls_checked = 0.0
        self.cpu = 0.0
        self._cpu_prev = None
        self.load = 0.0
        self.mem_frac = 0.0
        self.mem_used = self.mem_total = 0        # kB
        self.swap_frac = 0.0
        self.swap_used = self.swap_total = 0
        self.temp = None                          # CPU package, °C
        self.fans = []                            # (rpm, max rpm or None)
        self.battery = None                       # (percent, status)
        self.brightness = None                    # screen backlight, 0-100
        self.kbd = None                           # keyboard backlight, 0-100
        self.volume = None                        # (percent, muted)
        self.last_screen = 50                     # restore target after screen-off
        self.last_kbd = 50                        # restore target after keyboard-off
        temp_dir = hwmon_by_name("coretemp")
        self._temp_path = os.path.join(temp_dir, "temp1_input") if temp_dir else None
        self._fan_dir = None
        smc = hwmon_by_name("applesmc")
        if smc:
            # Fan attributes live on the class device on some kernels and on
            # the platform device on others.
            for probe in (smc, os.path.join(smc, "device")):
                if glob.glob(os.path.join(probe, "fan*_input")):
                    self._fan_dir = probe
                    break
        batteries = sorted(glob.glob("/sys/class/power_supply/BAT*"))
        self._battery_dir = batteries[0] if batteries else None
        # The Touch Bar's own strip is a backlight device too; skip it.
        screens = sorted(p for p in glob.glob("/sys/class/backlight/*")
                         if "appletb" not in p)
        self._backlight_dir = screens[0] if screens else None
        keyboards = sorted(glob.glob("/sys/class/leds/*kbd_backlight*"))
        self._kbd_dir = keyboards[0] if keyboards else None
        self.backlight_device = (os.path.basename(self._backlight_dir)
                                 if self._backlight_dir else None)
        self.kbd_device = os.path.basename(self._kbd_dir) if self._kbd_dir else None

    def refresh(self, interval=1.5):
        now = time.monotonic()
        if now - self.checked < interval:
            return False
        self.checked = now
        try:
            with open("/proc/stat") as handle:
                fields = [float(f) for f in handle.readline().split()[1:]]
            idle = fields[3] + fields[4]          # idle + iowait
            total = sum(fields)
            if self._cpu_prev:
                span = total - self._cpu_prev[1]
                if span > 0:
                    self.cpu = max(0.0, min(1.0,
                        1.0 - (idle - self._cpu_prev[0]) / span))
            self._cpu_prev = (idle, total)
        except (OSError, ValueError, IndexError):
            pass
        try:
            self.load = os.getloadavg()[0]
        except OSError:
            pass
        try:
            info = {}
            with open("/proc/meminfo") as handle:
                for line in handle:
                    key, _, rest = line.partition(":")
                    info[key] = int(rest.split()[0])
            self.mem_total = info.get("MemTotal", 0)
            self.mem_used = self.mem_total - info.get("MemAvailable", 0)
            self.swap_total = info.get("SwapTotal", 0)
            self.swap_used = self.swap_total - info.get("SwapFree", 0)
            self.mem_frac = self.mem_used / self.mem_total if self.mem_total else 0.0
            self.swap_frac = (self.swap_used / self.swap_total
                              if self.swap_total else 0.0)
        except (OSError, ValueError, IndexError):
            pass
        milli = read_int(self._temp_path) if self._temp_path else None
        self.temp = milli / 1000.0 if milli is not None else None
        fans = []
        if self._fan_dir:
            for path in sorted(glob.glob(os.path.join(self._fan_dir, "fan*_input"))):
                rpm = read_int(path)
                if rpm is not None:
                    fans.append((rpm, read_int(path[:-6] + "_max")))
        self.fans = fans
        if self._battery_dir:
            percent = read_int(os.path.join(self._battery_dir, "capacity"))
            try:
                with open(os.path.join(self._battery_dir, "status")) as handle:
                    status = handle.read().strip()
            except OSError:
                status = ""
            self.battery = (percent, status) if percent is not None else None
        return True

    @staticmethod
    def _level(directory):
        if not directory:
            return None
        current = read_int(os.path.join(directory, "brightness"))
        full = read_int(os.path.join(directory, "max_brightness"))
        if current is None or not full:
            return None
        return int(round(current * 100.0 / full))

    def refresh_controls(self, interval=1.5):
        now = time.monotonic()
        if now - self.controls_checked < interval:
            return False
        self.controls_checked = now
        self.brightness = self._level(self._backlight_dir)
        self.kbd = self._level(self._kbd_dir)
        if self.brightness:
            self.last_screen = self.brightness
        if self.kbd:
            self.last_kbd = self.kbd
        try:
            out = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"],
                                 capture_output=True, text=True, timeout=2).stdout
            match = re.search(r"([\d.]+)", out)
            self.volume = (int(round(float(match.group(1)) * 100)),
                           "MUTED" in out) if match else None
        except (OSError, subprocess.SubprocessError, ValueError):
            self.volume = None
        return True


def until(iso):
    """'2026-09-06T15:00:00+00:00' -> '6d'. Empty when it has already passed."""
    target = stamp_to_epoch(iso)
    if not target:
        return ""
    left = target - time.time()
    if left <= 0:
        return ""
    if left >= 86400:
        return "%dd" % round(left / 86400)
    if left >= 3600:
        return "%dh" % round(left / 3600)
    return "%dm" % max(1, round(left / 60))


class UsageLimits:
    """Claude Code's own cached rate-limit read-out.

    This is what `/usage` renders. Claude Code refreshes it into ~/.claude.json
    under `cachedUsageUtilization`, so the real session and weekly headroom is
    available without an API call and without touching the OAuth token.

    `limits` is a list of {kind, percent, severity, resets_at, scope}; kinds are
    `session`, `weekly_all` and `weekly_scoped` (scoped to a model, e.g. Fable).
    `percent` is the share *used*.
    """

    def __init__(self):
        self.stamp = None
        self.entries = {}
        self.fetched = 0.0
        self.checked = 0.0

    def refresh(self, interval=10.0):
        now = time.monotonic()
        if now - self.checked < interval:
            return
        self.checked = now
        try:
            info = os.stat(CLAUDE_CONFIG)
        except OSError:
            return
        stamp = (info.st_mtime, info.st_size)
        if stamp == self.stamp:
            return
        self.stamp = stamp
        try:
            with open(CLAUDE_CONFIG) as handle:
                cached = (json.load(handle) or {}).get("cachedUsageUtilization") or {}
        except (OSError, ValueError):
            return
        self.fetched = (cached.get("fetchedAtMs") or 0) / 1000.0
        entries = {}
        for item in ((cached.get("utilization") or {}).get("limits") or []):
            if not isinstance(item, dict):
                continue
            kind = item.get("kind") or ""
            model = ((item.get("scope") or {}).get("model") or {}).get("display_name")
            if kind == "weekly_scoped":
                kind = "weekly_" + (model or "model").lower().replace(" ", "")
            entries[kind] = {
                "percent": item.get("percent"),
                "resets_at": item.get("resets_at"),
                "severity": item.get("severity") or "normal",
                "model": model or "",
            }
        self.entries = entries

    def get(self, kind):
        return self.entries.get(kind)

    def scoped_kind(self):
        """The model-scoped weekly bucket, whatever model it is scoped to."""
        for kind in self.entries:
            if kind.startswith("weekly_") and kind != "weekly_all":
                return kind
        return None

    def stale(self):
        return self.fetched and (time.time() - self.fetched) > 3600


class ClaudeTotals:
    """Running token totals across every Claude Code transcript on this machine.

    The whole corpus is a few megabytes, so the first pass is cheap and every
    pass after that reads only what was appended.
    """

    WINDOW = 7 * 86400

    def __init__(self):
        self.offsets = {}
        self.total = 0
        self.recent = []          # (epoch, tokens) inside the rolling window
        self.checked = 0.0

    def refresh(self, interval=15.0, force=False):
        now = time.monotonic()
        if not force and now - self.checked < interval:
            return
        self.checked = now
        for path in glob.glob(os.path.join(HOME, ".claude", "projects", "*", "*.jsonl")):
            try:
                size = os.path.getsize(path)
            except OSError:
                continue
            start = self.offsets.get(path, 0)
            if size < start:                      # truncated or replaced
                start = 0
            if size == start:
                continue
            try:
                with open(path, "r", errors="replace") as handle:
                    handle.seek(start)
                    chunk = handle.read()
                    self.offsets[path] = handle.tell()
            except OSError:
                continue
            for line in chunk.splitlines():
                if '"usage"' in line:
                    self._absorb(line)
        cutoff = time.time() - self.WINDOW
        self.recent = [(t, n) for t, n in self.recent if t >= cutoff]

    def _absorb(self, line):
        try:
            record = json.loads(line)
        except ValueError:
            return
        usage = (record.get("message") or {}).get("usage") or {}
        if not usage:
            return
        tokens = (usage.get("input_tokens", 0)
                  + usage.get("cache_read_input_tokens", 0)
                  + usage.get("cache_creation_input_tokens", 0)
                  + usage.get("output_tokens", 0))
        if not tokens:
            return
        self.total += tokens
        self.recent.append((stamp_to_epoch(record.get("timestamp")), tokens))

    def week(self):
        cutoff = time.time() - self.WINDOW
        return sum(n for t, n in self.recent if t >= cutoff)


def child_pids(pid):
    """Children of every thread, not just the main one: GTK terminals like
    Ghostty spawn their shells from worker threads, and those children only
    appear in that thread's /proc/<pid>/task/<tid>/children."""
    kids = []
    try:
        tids = os.listdir("/proc/%d/task" % pid)
    except OSError:
        return kids
    for tid in tids:
        try:
            with open("/proc/%d/task/%s/children" % (pid, tid)) as handle:
                kids.extend(int(x) for x in handle.read().split())
        except (OSError, ValueError):
            continue
    return kids


def descendant_named(pid, name, depth=0):
    """Find `claude` running under a terminal window's process."""
    if depth > 6:
        return None
    try:
        with open("/proc/%d/comm" % pid) as handle:
            if handle.read().strip() == name:
                return pid
    except OSError:
        return None
    for kid in child_pids(pid):
        found = descendant_named(kid, name, depth + 1)
        if found:
            return found
    return None


class ClaudeSession:
    """Reads a Claude Code transcript incrementally and keeps a running tally.

    Everything here comes out of ~/.claude/projects/<slug>/<session>.jsonl, which
    Claude Code appends to as it goes - no hooks, no settings changes, and it
    works for every session automatically.
    """

    IDLE, THINKING, TOOL = "idle", "thinking", "tool"

    def __init__(self, path):
        self.path = path
        self.offset = 0
        self.reset()

    def reset(self):
        self.title = ""
        self.permission = ""
        self.context = 0
        self.output = 0
        self.cache_read = 0
        self.turns = 0
        self.tools = {}
        self.first_ts = self.last_ts = ""
        self.state = self.IDLE
        self.tool = ""
        self.model = ""
        self.effort = ""
        self.reported = ""
        self.name = ""

    def refresh(self):
        try:
            size = os.path.getsize(self.path)
        except OSError:
            return False
        if size < self.offset:              # rotated or replaced
            self.offset = 0
            self.reset()
        elif size == self.offset:
            return False
        try:
            with open(self.path, "r", errors="replace") as handle:
                handle.seek(self.offset)
                chunk = handle.read()
                self.offset = handle.tell()
        except OSError:
            return False
        for line in chunk.splitlines():
            if line.strip():
                self._absorb(line)
        return True

    def _absorb(self, line):
        try:
            record = json.loads(line)
        except ValueError:
            return
        kind = record.get("type")
        if kind == "ai-title":
            self.title = record.get("aiTitle", "") or self.title
            return
        if kind == "permission-mode":
            self.permission = record.get("permissionMode", "") or self.permission
            return
        if kind not in ("user", "assistant") or record.get("isSidechain"):
            return
        stamp = record.get("timestamp")
        if stamp:
            self.first_ts = self.first_ts or stamp
            self.last_ts = stamp
        message = record.get("message") or {}
        self.model = message.get("model") or self.model
        self.effort = record.get("effort") or self.effort
        usage = message.get("usage") or {}
        if usage:
            self.output += usage.get("output_tokens", 0)
            self.cache_read += usage.get("cache_read_input_tokens", 0)
            self.context = (usage.get("input_tokens", 0)
                            + usage.get("cache_read_input_tokens", 0)
                            + usage.get("cache_creation_input_tokens", 0))
        blocks = message.get("content")
        blocks = blocks if isinstance(blocks, list) else []
        kinds = {b.get("type") for b in blocks if isinstance(b, dict)}
        if kind == "user":
            # A tool result is Claude's own turn continuing, not a new prompt.
            if "tool_result" not in kinds:
                self.turns += 1
            self.state, self.tool = self.THINKING, ""
            return
        pending = [b for b in blocks if isinstance(b, dict) and b.get("type") == "tool_use"]
        for block in pending:
            name = block.get("name", "?")
            self.tools[name] = self.tools.get(name, 0) + 1
        if pending:
            # Written before the tool runs, so the last one is the running one.
            self.state, self.tool = self.TOOL, pending[-1].get("name", "")
        else:
            self.state, self.tool = self.IDLE, ""

    @property
    def busy(self):
        if self.reported:
            return self.reported == "busy"
        return self.state != self.IDLE

    def elapsed(self):
        try:
            start = time.mktime(time.strptime(self.first_ts[:19], "%Y-%m-%dT%H:%M:%S"))
            end = time.mktime(time.strptime(self.last_ts[:19], "%Y-%m-%dT%H:%M:%S"))
        except (ValueError, TypeError):
            return ""
        minutes = max(0, int((end - start) // 60))
        return "%dh%02d" % (minutes // 60, minutes % 60) if minutes >= 60 else "%dm" % minutes


def transcript_for(cwd):
    slug = cwd.replace("/", "-")
    found = glob.glob(os.path.join(HOME, ".claude", "projects", slug, "*.jsonl"))
    return max(found, key=os.path.getmtime) if found else None


# ------------------------------------------------------------- hyprland ipc --
def _hypr_socket_candidates(name):
    """Return live, user-owned Hyprland sockets in preference order.

    A persistent systemd user unit can start before Hyprland exports
    HYPRLAND_INSTANCE_SIGNATURE, and the user manager does not necessarily
    inherit that variable later.  Discovering sockets beneath the private
    XDG runtime directory keeps the daemon attached across that startup race
    and across compositor restarts.
    """
    directories = []

    def add(directory):
        if directory and directory not in directories:
            directories.append(directory)

    with _HYPR_STATE_LOCK:
        add(_HYPR_DIR_CACHE)
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "").strip()
    if signature and os.path.basename(signature) == signature:
        add(os.path.join(HYPR_ROOT, signature))

    discovered = []
    try:
        for entry in os.scandir(HYPR_ROOT):
            try:
                info = entry.stat(follow_symlinks=False)
            except OSError:
                continue
            if entry.is_dir(follow_symlinks=False) and info.st_uid == os.getuid():
                socket_path = os.path.join(entry.path, name)
                try:
                    socket_info = os.stat(socket_path, follow_symlinks=False)
                except OSError:
                    continue
                if stat.S_ISSOCK(socket_info.st_mode) and socket_info.st_uid == os.getuid():
                    discovered.append((socket_info.st_mtime_ns, entry.path))
    except OSError:
        pass
    for _, directory in sorted(discovered, reverse=True):
        add(directory)

    paths = []
    for directory in directories:
        path = os.path.join(directory, name)
        try:
            info = os.stat(path, follow_symlinks=False)
        except OSError:
            continue
        if stat.S_ISSOCK(info.st_mode) and info.st_uid == os.getuid():
            paths.append(path)
    return paths


def _hypr_problem(message):
    global _HYPR_ERROR
    with _HYPR_STATE_LOCK:
        if message == _HYPR_ERROR:
            return
        _HYPR_ERROR = message
    sys.stderr.write("omarchy-touchbar: Hyprland IPC unavailable: %s\n" % message)
    sys.stderr.flush()


def _hypr_connected(path):
    global _HYPR_DIR_CACHE, _HYPR_ERROR
    recovered = False
    with _HYPR_STATE_LOCK:
        _HYPR_DIR_CACHE = os.path.dirname(path)
        recovered = _HYPR_ERROR is not None
        _HYPR_ERROR = None
    if recovered:
        sys.stderr.write("omarchy-touchbar: Hyprland IPC connected\n")
        sys.stderr.flush()


def _open_hypr_socket(name):
    paths = _hypr_socket_candidates(name)
    if not paths:
        _hypr_problem("no %s socket found beneath %s" % (name, HYPR_ROOT))
        return None
    last_error = None
    for path in paths:
        sock = None
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.settimeout(2.0)
            sock.connect(path)
            _hypr_connected(path)
            return sock
        except OSError as exc:
            last_error = exc
            if sock is not None:
                sock.close()
    _hypr_problem(str(last_error or "connection failed"))
    return None


def hypr(command, as_json=True):
    sock = _open_hypr_socket(".socket.sock")
    if sock is None:
        return None
    try:
        sock.sendall((("j/" if as_json else "/") + command).encode())
        chunks = []
        size = 0
        while True:
            chunk = sock.recv(65536)
            if not chunk:
                break
            size += len(chunk)
            if size > 8 * 1024 * 1024:
                raise ValueError("Hyprland response exceeds 8 MiB")
            chunks.append(chunk)
        raw = b"".join(chunks)
        return json.loads(raw) if as_json else raw.decode()
    except (OSError, UnicodeError, ValueError, json.JSONDecodeError) as exc:
        _hypr_problem(str(exc))
        return None
    finally:
        sock.close()


# ----------------------------------------------------------- button drawing --
def cell_width(slots):
    cells = slots + 1                       # tiny-dfr prepends its own esc key
    return (BAR_WIDTH - BUTTON_SPACING * (cells - 1)) / cells


def layout_metrics(specs):
    """Return pixel left/width pairs using tiny-dfr's Stretch proportions."""
    weights = [1] + [max(1, int(item.get("stretch", 1) or 1)) for item in specs]
    gaps = max(0, len(weights) - 1)
    unit = (BAR_WIDTH - BUTTON_SPACING * gaps) / float(sum(weights))
    metrics = []
    left = 0.0
    for weight in weights:
        width = unit * weight
        metrics.append((left, width))
        left += width + BUTTON_SPACING
    return metrics


def build_goal_svg(spec, width, font):
