def parse_chord(spec):
    """'CTRL+SHIFT+Tab' -> ['LeftCtrl', 'LeftShift', 'Tab']."""
    if not spec:
        return []
    keys = []
    for part in [p for p in str(spec).replace(" ", "").split("+") if p]:
        upper = part.upper()
        if upper in MODIFIERS:
            keys.append(MODIFIERS[upper])
        elif upper in KEY_ALIASES:
            keys.append(KEY_ALIASES[upper])
        elif re.fullmatch(r"F([1-9]|1\d|2[0-4])", upper):
            keys.append(upper)
        elif len(part) == 1 and part.isalpha():
            keys.append(part.upper())
        else:
            keys.append(part)  # raw input-linux name, e.g. PlayPause
    return keys


