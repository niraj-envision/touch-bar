        self.palette = Palette(load_toml(THEME_COLORS, FALLBACK_THEME))
        self.stamps = self._stamps()
        self.icons = IconCache(clear=clear_cache)
        self.page = "auto"
        self.window_slots = []
        self.last_written = None
        self.prev_specs = []
        self.generation = 0
        self.lock = threading.Lock()
        self.write_lock = threading.Lock()
        self.pending = None
        self.pending_since = 0.0
        self.pending_hit_regions = None
        self.last_change = 0.0
        self.pending_actions = None
        self.touch_actions = [None] * (int(self.config["settings"]["slots"]) + 1)
        self.touch_regions = []
        self.last_touch = None
        self.touch_down = False
        self.touch_released_at = 0.0
        # Fn is a momentary hardware key but a tap toggles our own settings
        # dashboard. Writes still wait for key-up so tiny-dfr never swaps a
        # layout beneath the physical media layer mid-press.
        self.fn_down = False
        self.fn_overlay_return = None
        self.voice_state = "idle"
        self.voice_backend = None
        self.voice_target = None
        self.voice_phase = 0
        self.review_until = 0.0
        self.voice_level_lock = threading.Lock()
        self.voice_levels = deque([(0.0, 0.0)] * 61, maxlen=61)
        self.voice_peak = 0.0
        self.voice_peak_dbfs = -120.0
        self.chatgpt_stats = {}
        self.chatgpt_thinking = False
        self.chatgpt_usage = None
        self.chatgpt_phase = 0
        self.claude = None            # ClaudeSession for the focused window
        self.claude_phase = 0
        self.claude_probe = (None, 0.0, None)   # (window pid, checked at, claude pid)
        self.totals = ClaudeTotals()
        self.limits = UsageLimits()
        self.media = MediaState()
        self.media_phase = 0
        self.stats = SystemStats()
        self.browser = BrowserTabs()
        self.browser_offset = 0
        self.browser_capacity = 0
        self.browser_marquee = 0
        self.browser_has_marquee = False
        self.browser_active = False
        self.browser_user_paging_until = 0.0
        self.goal_queue = deque()
        self.goal_active = None
        self.goal_animating = False
        # Animation frames arrive several times a second; each render used to
        # cost four Hyprland IPC round-trips. Cache the compositor state and
        # let the event watcher invalidate it, so polling threads ride the
        # cache and only real changes touch the socket.
        self._active_cache = {}
        self._active_at = 0.0
        self._snapshot_cache = None
        self._snapshot_at = 0.0

    def _stamps(self):
        out = []
        for path in (USER_CONFIG, THEME_COLORS):
            try:
                out.append(os.stat(path).st_mtime)
            except OSError:
                out.append(0)
        return out

    def reload_if_changed(self):
        stamps = self._stamps()
        if stamps != self.stamps:
            self.config = load_config()
            self.palette = Palette(load_toml(THEME_COLORS, FALLBACK_THEME))
            self.stamps = stamps
            self.last_written = None      # colours may have changed everywhere

    # -- state ------------------------------------------------------------
    def snapshot(self, max_age=0.5):
        now = time.monotonic()
        if self._snapshot_cache is not None and now - self._snapshot_at < max_age:
            return self._snapshot_cache
        snap = (
            hypr("clients") or [],
            hypr("workspaces") or [],
            hypr("activeworkspace") or {},
            hypr("activewindow") or {},
        )
        self._snapshot_cache, self._snapshot_at = snap, now
        self._active_cache, self._active_at = snap[3], now
        return snap

    def invalidate_state(self):
        self._active_at = 0.0
        self._snapshot_at = 0.0

    def claude_pid(self, active_win):
        """The `claude` process running under this window, if there is one."""
        pid = (active_win or {}).get("pid")
        if not pid:
            return None
        known_pid, checked, found = self.claude_probe
        if known_pid == pid and time.monotonic() - checked < 2.0:
            return found
        found = descendant_named(int(pid), "claude")
        self.claude_probe = (pid, time.monotonic(), found)
        return found

    def claude_cwd(self, active_win):
        pid = self.claude_pid(active_win)
        if not pid:
            return None
        try:
            return os.readlink("/proc/%d/cwd" % pid)
        except OSError:
            return None

    def claude_for(self, active_win):
        """Keep a reader alive for whichever session is on screen."""
        pid = self.claude_pid(active_win)
        if not pid:
            self.claude = None
            return None
        record = session_status(pid)
        cwd = record.get("cwd") or self.claude_cwd(active_win)
        path = None
        if cwd and record.get("sessionId"):
            exact = os.path.join(HOME, ".claude", "projects",
                                 cwd.replace("/", "-"), record["sessionId"] + ".jsonl")
            path = exact if os.path.exists(exact) else None
        if path is None and cwd:
            path = transcript_for(cwd)
        if not path:
            self.claude = None
            return None
        if self.claude is None or self.claude.path != path:
            self.claude = ClaudeSession(path)
        self.claude.refresh()
        # Claude Code publishes its own busy flag; trust it over the tail read.
        self.claude.reported = record.get("status") or ""
        self.claude.name = record.get("name") or ""
        self.totals.refresh()
        self.limits.refresh()
        return self.claude

    def claude_profile(self):
        for profile in self.config["profiles"]:
            if profile.get("claude"):
                return profile
        return None

    def profile_for(self, active_win):
        active_win = active_win or {}
        claude_profile = self.claude_profile()
        if claude_profile is not None and self.claude_cwd(active_win):
            return claude_profile
        window_class = active_win.get("class", "") or ""
        title = active_win.get("title", "") or ""
        tags = [t.rstrip("*") for t in (active_win.get("tags") or [])]
        for profile in self.config["profiles"]:
            try:
                tag_pattern = profile.get("match_tag")
                if tag_pattern and any(re.search(tag_pattern, t, re.I) for t in tags):
                    return profile
                pattern = profile.get("match")
                if pattern and re.search(pattern, window_class, re.I):
                    return profile
                title_pattern = profile.get("match_title")
                if title_pattern and re.search(title_pattern, title, re.I):
                    return profile
            except re.error:
                continue
        for profile in self.config["profiles"]:
            if profile.get("default"):
                return profile
        return {}

    def workspace_ids(self, workspaces):
        settings = self.config["settings"]
        occupied = [w.get("id", 0) for w in workspaces if w.get("id", 0) > 0]
        highest = max(occupied) if occupied else int(settings["workspaces"])
        count = max(int(settings["workspaces"]),
                    min(highest, int(settings["max_workspaces"])))
        return list(range(1, count + 1))

    # -- groups -----------------------------------------------------------
    def workspace_group(self, workspaces, active_ws, collapsed):
        current = active_ws.get("id")
        ids = self.workspace_ids(workspaces)
        populated = {w.get("id"): w.get("windows", 0) for w in workspaces}
        if collapsed:
            # Folded into one pill so the app keeps the width; tap opens the
            # picker. The dot row still shows where you are at a glance.
            dots = "".join("\u25cf" if index == current else "\u25cb"
                           for index in ids)
            return [spec(str(current or 1), None, fill="accent", fg="on_accent",
                         size=27, sub=dots, sub_fg="on_accent", sub_size=12,
                         daemon="page:workspaces")]
        rows = []
        for index in ids:
            active = index == current
            windows = populated.get(index, 0)
            rows.append(spec(
                str(index), None,
                fill="accent" if active else "surface",
                fg="on_accent" if active else ("fg" if windows else "muted"),
                size=27, badge=(windows or None),
                daemon="workspace:%d" % index,
            ))
        return rows

    def media_group(self):
        """Transport for whatever is playing, anywhere. Costs nothing when
        silent, and displaces the typing shortcuts rather than the read-out."""
        if not self.media.active:
            return []
        if self.media.playing:
            lead = spec("", None, fill="accent", fg="on_accent",
                        bars=EQUALIZER[self.media_phase % len(EQUALIZER)],
                        daemon="media:playpause")
        else:
            lead = spec("\uf04b", None, fill="sunken", fg="green", size=24,
                        daemon="media:playpause")
        return [
            spec("\uf048", None, fill="sunken", fg="fg", size=22,
                 daemon="media:previous"),
            lead,
            spec("\uf051", None, fill="sunken", fg="fg", size=22,
                 daemon="media:next"),
            spec("\uf028", None, fill="sunken",
                 fg="red" if self.media.muted else "fg", size=22,
                 sub="muted" if self.media.muted else "", sub_fg="red",
                 daemon="media:mute"),
        ]

    def limit_tile(self, kind, caption):
        """Headroom left on one rate-limit bucket, with its reset countdown."""
        info = self.limits.get(kind)
        if not info or info.get("percent") is None:
            return spec("\u2013", None, fill="sunken", fg="muted", size=21,
                        gloss=False, sub=caption)
        left = max(0, 100 - int(info["percent"]))
        if info.get("severity") in ("warning", "critical"):
            color = "red"
        else:
            color = "green" if left > 40 else "yellow" if left > 15 else "red"
        when = until(info.get("resets_at"))
        return spec("%d%%" % left, None, fill="sunken",
                    fg="muted" if self.limits.stale() else color,
                    size=27, gloss=False,
                    sub="%s %s" % (caption, when) if when else caption)

    def claude_tiles(self, session):
        """Live session read-out: what it is doing, and what it has spent."""
        settings = self.config["settings"]
        if session is None:
            return [spec("\uf0e7", None, fill="sunken", fg="muted",
                         size=26, sub="claude")]
        if session.busy:
            frame = SPINNER[self.claude_phase % len(SPINNER)]
            caption = (session.tool or "thinking").lower()[:9]
            lead = spec(frame, None, fill="accent", fg="on_accent",
                        size=30, glow=True, sub=caption, sub_fg="on_accent")
        else:
            # Idle: name the model, and make it the shortcut for changing it.
            short = re.sub(r"^claude-", "", session.model or "").replace("-", " ")
            lead = spec(short or "claude", None, fill="sunken", fg="accent",
                        size=21, gloss=False, sub="model \u25be",
                        daemon="page:models")

        limit = int(settings.get("claude_context_limit", 0) or 0)
        if limit <= 0:
            # Nothing in the transcript names the window; infer the 1M variant
            # from a context that a 200k model could never have reached.
            limit = 1_000_000 if session.context > 190_000 else 200_000
        used = min(1.0, session.context / float(limit))
        bar_color = "green" if used < 0.6 else "yellow" if used < 0.85 else "red"
        context = spec("%d%%" % round(used * 100), None, fill="sunken",
                       fg=bar_color, size=27, gloss=False,
                       sub="ctx %s" % compact(session.context))

        # Claude Code caches the real buckets, so the local token budget is now
        # only a fallback for when no model-scoped weekly limit is reported.
        scoped = self.limits.scoped_kind()
        scoped_name = (self.limits.get(scoped) or {}).get("model") or "model"
        if scoped:
            third = self.limit_tile(scoped, scoped_name.lower())
        else:
            week = self.totals.week()
            budget = int(settings.get("claude_weekly_budget", 0) or 0)
            if budget > 0:
                used = min(1.0, week / float(budget))
                third = spec("%d%%" % round((1 - used) * 100), None, fill="sunken",
                             fg="fg", size=21, gloss=False, sub="left", gauge=1 - used,
                             bar=("green" if used < 0.6 else
                                  "yellow" if used < 0.85 else "red"),
                             track="darker_background")
            else:
                third = spec(compact(week), None, fill="sunken", fg="yellow",
                             size=21, gloss=False, sub="week")

        tiles = [
            lead,
            self.limit_tile("session", "session"),
            self.limit_tile("weekly_all", "week"),
            third,
            context,
            spec(compact(self.totals.total), None, fill="sunken", fg="cyan",
                 size=24, gloss=False, sub="lifetime"),
        ]
        # The whole read-out is one big button: tap anywhere to expand it.
        for tile in tiles:
            tile["daemon"] = "page:claude"
        return tiles

    def context_group(self, profile):
        mode = PERMISSION_LABELS.get(
            (self.claude.permission if self.claude else ""), "mode")
        rows = [
            spec(entry.get("label", "").replace("{mode}", mode), entry.get("keys"),
                 fill=entry.get("background", "surface"),
                 fg=entry.get("color", "fg"),
                 size=entry.get("size", 26))
            for entry in profile.get("buttons", [])
        ]
        if profile.get("claude"):
            # The read-out moved to the identity slot so media controls can sit
            # between it and the shortcuts, and so the shortcuts are what gets
            # squeezed when the bar runs out of room.
            return rows
        if profile.get("name") == "ChatGPT":
            return self.chatgpt_tiles() + rows
        return rows

    def chatgpt_tiles(self):
        """Claude-style live telemetry for the ChatGPT/Codex desktop app."""
        data = self.chatgpt_stats
        phases = ("󰔟", "󰔚", "󰔛", "󰔜")
        label = phases[self.chatgpt_phase % len(phases)] \
            if self.chatgpt_thinking else "󰭹"
        caption = (data.get("tool") or
                   ("thinking" if self.chatgpt_thinking else "ready"))[:9]
        lead = spec(label, None,
                    fill="accent" if self.chatgpt_thinking else "sunken",
                    fg="on_accent" if self.chatgpt_thinking else "green",
                    size=29, glow=self.chatgpt_thinking, sub=caption,
                    sub_fg="on_accent" if self.chatgpt_thinking else "muted")

        context = int(data.get("context") or 0)
        limit = int(data.get("context_limit") or 0)
        share = min(1.0, context / float(limit)) if limit else 0.0
        context_color = "green" if share < 0.6 else "yellow" if share < 0.85 else "red"
        context_tile = spec(
            "%d%%" % round(share * 100) if limit else "--",
            None, fill="sunken", fg="fg", size=21, gloss=False,
            sub=compact(context), gauge=share, bar=context_color,
            track="darker_background")

        usage = data.get("usage")
        usage_color = "green" if usage is None or usage < 50 \
            else "yellow" if usage < 80 else "red"
        usage_tile = spec(
            "%d%%" % usage if usage is not None else "--",
            None, fill="sunken", fg=usage_color, size=21, gloss=False,
            sub="usage", gauge=(min(1.0, usage / 100.0) if usage is not None else 0),
            bar=usage_color, track="darker_background")

        tiles = [
            lead,
            context_tile,
            spec(compact(data.get("output")), None, fill="sunken", fg="magenta",
                 size=21, gloss=False, sub="output"),
            spec(str(data.get("turns", 0)), None, fill="sunken", fg="blue",
                 size=21, gloss=False, sub="turns"),
            usage_tile,
        ]
        for tile in tiles:
            tile["daemon"] = "page:chatgpt"
        return tiles

    def app_identity(self, profile, active_win):
        glyph = profile.get("icon")
        color = profile.get("icon_color", "accent")
        if not glyph:
            glyph, color = self.glyph_for(active_win or {})
        return [spec(glyph, None, fill="sunken", fg=color, size=28, glow=True)]

    def voice_backend_for(self, active_win):
        # Keep dictation visually and functionally inside the Touch Bar for
        # every focused application; native app recorders create a duplicate
        # main-window UI instead of supplying our audio envelope.
        return "voxtype"

    def voice_group(self):
        """A compact launcher; active dictation owns the full Touch Bar."""
        if self.voice_state != "idle":
            return []
        return [spec("", None, fill="sunken", fg="magenta", size=27,
                     daemon="voice:toggle")]

    def voice_overlay(self):
        """Full-width, Touch-Bar-only dictation interface."""
        if self.voice_state == "recording":
            with self.voice_level_lock:
                wave = tuple(self.voice_levels)
                peak = self.voice_peak
            color = "red" if peak >= 0.92 else \
                "yellow" if peak >= 0.70 else "cyan"
            return [
                spec("●", None, fill="raised", fg="red", size=25,
                     sub="LIVE MIC", sub_size=10, glow=False,
                     daemon="voice:pause"),
                spec("", None, fill="sunken", fg=color, gloss=False,
                     glow=False, waveform=wave, stretch=9,
                     daemon="voice:pause"),
                spec("", None, fill="raised", fg="yellow", size=25,
                     sub="stop", sub_size=11, daemon="voice:pause"),
                spec("󰆴", None, fill="sunken", fg="red", size=28,
                     sub="delete", sub_size=11, daemon="voice:delete"),
            ]
        if self.voice_state == "transcribing":
            return [
                spec(SPINNER[self.voice_phase % len(SPINNER)], None,
                     fill="sunken", fg="yellow", size=31, glow=False,
                     sub="transcribing", sub_size=13, stretch=11),
                spec("󰆴", None, fill="sunken", fg="red", size=28,
                     sub="cancel", sub_size=11, daemon="voice:delete"),
            ]
        return [
            spec("󰏤", None, fill="sunken", fg="muted", size=29,
                 sub="paused", sub_size=12, stretch=9),
            spec("󰍬", None, fill="raised", fg="magenta", size=29,
                 sub="add", sub_size=11, daemon="voice:add"),
            spec("󰒊", None, fill="green", fg="on_accent", size=29,
                 sub="send", sub_size=11, daemon="voice:send"),
            spec("󰆴", None, fill="red", fg="on_accent", size=28,
                 sub="delete", sub_size=11, daemon="voice:delete"),
        ]

    def reset_voice_meter(self):
        with self.voice_level_lock:
            self.voice_levels.clear()
            self.voice_levels.extend([(0.0, 0.0)] * self.voice_levels.maxlen)
            self.voice_peak = 0.0
            self.voice_peak_dbfs = -120.0

    def ingest_voice_level(self, minimum, maximum, peak_dbfs):
        """Map a real audio frame to a two-sided, speech-sensitive envelope."""
        minimum, maximum, peak_dbfs = float(minimum), float(maximum), float(peak_dbfs)
        strength = (min(1.0, max(0.0, (peak_dbfs + 58.0) / 46.0)) ** 0.72
                    if math.isfinite(peak_dbfs) else 0.0)
        sample_peak = max(abs(minimum), abs(maximum))
        if sample_peak > 1e-9 and strength > 0.0:
            low = -strength * min(1.0, abs(minimum) / sample_peak)
            high = strength * min(1.0, abs(maximum) / sample_peak)
        else:
            low, high = 0.0, 0.0
        with self.voice_level_lock:
            self.voice_levels.append((low, high))
            self.voice_peak = min(1.0, max(strength, self.voice_peak * 0.97))
            self.voice_peak_dbfs = peak_dbfs

    def tab_group(self, profile):
        """Static fallback for non-Firefox browsers or a missing session."""
        glyphs = profile.get("tab_icons", [""])
        colors = profile.get("tab_colors", ["blue", "magenta", "red", "yellow"])
        return [
            spec(glyphs[(n - 1) % len(glyphs)], "CTRL+%d" % n,
                 fill="raised", fg=colors[(n - 1) % len(colors)], size=24,
                 badge=n)
            for n in range(1, int(profile.get("tabs", 0)) + 1)
        ]

    def browser_controls(self, profile):
        wanted = ("ALT+LEFT", "CTRL+T", "CTRL+W")
        by_key = {str(entry.get("keys", "")).replace(" ", "").upper(): entry
                  for entry in profile.get("buttons", [])}
        rows = []
        for key in wanted:
            entry = by_key.get(key)
            if not entry:
                continue
            rows.append(spec(entry.get("label", ""), entry.get("keys"),
                             fill=entry.get("background", "sunken"),
                             fg=entry.get("color", "fg"),
                             size=entry.get("size", 25)))
        return rows

    def browser_tab_group(self, profile, active_win, capacity):
        self.browser.refresh(active_win)
        tabs = self.browser.tabs
        self.browser_capacity = max(1, capacity)
        self.browser_has_marquee = False
        if not tabs:
            self.browser_offset = 0
            return self.tab_group(profile)[:capacity]

        last_page = ((len(tabs) - 1) // self.browser_capacity) * self.browser_capacity
        self.browser_offset = max(0, min(self.browser_offset, last_page))
        selected = self.browser.selected
        user_paging = time.monotonic() < self.browser_user_paging_until
        if not user_paging and not (
                self.browser_offset <= selected < self.browser_offset + self.browser_capacity):
            self.browser_offset = (selected // self.browser_capacity) * self.browser_capacity

        visible = tabs[self.browser_offset:self.browser_offset + self.browser_capacity]
        total = len(tabs)
        stretch = 12 if total == 1 else 6 if total == 2 else 4 if total == 3 \
            else 3 if total == 4 else 2 if total == 5 else 1
        compact_tabs = total >= 6
        rows = []
        for local, tab in enumerate(visible):
            target = self.browser_offset + local
            active = target == selected
            title = tab.get("title") or "New tab"
            favicon = self.browser.favicon(tab) or GENERIC_FAVICON
            rows.append(spec(
                "", None,
                fill="accent" if active else "surface",
                fg="on_accent" if active else "fg",
                gloss=not active,
                badge=target + 1,
                daemon="browser-tab:%d" % target,
                favicon=favicon,
                tab_title=title,
                tab_active=active,
                tab_compact=compact_tabs,
                marquee=self.browser_marquee,
                stretch=stretch,
            ))
            if not compact_tabs and len(title) > 8:
                self.browser_has_marquee = True
        return rows

    def page_browser(self, profile, active_win):
        """Live favicon tab strip with a small, stable browser control cluster."""
        self.browser_active = True
        trailing = self.voice_group() + self.mode_group()
        controls = self.browser_controls(profile)
        capacity = max(1, int(self.config["settings"]["slots"])
                       - len(trailing) - len(controls))
        tabs = self.browser_tab_group(profile, active_win, capacity)
        return self.compose([tabs, controls], trailing)

    def window_group(self, clients, active_win, budget, profile):
        settings = self.config["settings"]
        limit = profile.get("windows", settings["windows"])
        count = min(int(limit), max(0, budget))
        if count <= 0:
            self.window_slots = []
            return []
        active_address = (active_win or {}).get("address")
        ordered = sorted(
            [c for c in clients if c.get("mapped", True) and not c.get("hidden")],
            key=lambda c: c.get("focusHistoryID", 999),
        )
        ordered = [c for c in ordered if c.get("address") != active_address][:count]
        self.window_slots = [c.get("address") for c in ordered]
        rows = []
        for index, client in enumerate(ordered):
            glyph, color = self.glyph_for(client)
            rows.append(spec(glyph, None, fill="sunken", fg=color,
                             daemon="focus:%s" % client.get("address")))
        return rows

    def glyph_for(self, client):
        window_class = client.get("class", "") or ""
        for pattern, value in self.config["icons"].items():
            try:
                if not re.search(pattern, window_class, re.I):
                    continue
            except re.error:
                continue
            if isinstance(value, (list, tuple)):
                return (value[0], value[1] if len(value) > 1 else "fg")
            return (value, "fg")
        return ((window_class[:1] or "?").upper(), "muted")

    def mode_group(self):
        icons = {"auto": "󰀻", "apps": "",
                 "system": "󰍛", "settings": "", "fn": ""}
        colors = {"auto": "accent", "apps": "green", "system": "cyan",
                  "settings": "yellow", "fn": "muted"}
        rows = [spec(icons.get(self.page, ""), None,
                     fill="sunken", fg=colors.get(self.page, "muted"), size=24,
                     daemon="page:next")]
        settings = self.config["settings"]
        if settings.get("clock"):
            rows.append({"time": settings["clock"]})
        if settings.get("battery"):
            rows.append({"battery": settings["battery"]})
        return rows

    # -- pages ------------------------------------------------------------
    def compose(self, groups, trailing):
        """Always the same number of buttons, whatever is on the bar."""
        budget = max(1, int(self.config["settings"]["slots"]) - len(trailing))
        rows = []
        for group in groups:
            rows.extend(group[: max(0, budget - len(rows))])
        rows.extend(BLANK for _ in range(budget - len(rows)))
        return rows + trailing

    def toggle_fn_dashboard(self):
        """A Fn tap opens the hardware dashboard; the next one restores UI."""
        if self.page == "settings":
            self.page = self.fn_overlay_return or "auto"
            self.fn_overlay_return = None
        else:
            self.fn_overlay_return = self.page if self.page in PAGES else "auto"
            self.page = "settings"
        self.prev_specs = []
        self.render(allow_animation=False)

    def page_auto(self):
        clients, workspaces, active_ws, active_win = self.snapshot()
        self.claude_for(active_win)
        profile = self.profile_for(active_win)
        if profile.get("name") == "Browser":
            return self.page_browser(profile, active_win)
        trailing = self.voice_group() + self.mode_group()
        budget = max(1, int(self.config["settings"]["slots"]) - len(trailing))
        ws_row = self.workspace_group(
            workspaces, active_ws, profile.get("collapse_workspaces", False)
        )
        if profile.get("claude"):
            identity_row = self.claude_tiles(self.claude)
        elif profile.get("show_identity") is False:
            identity_row = []
        else:
            identity_row = self.app_identity(profile, active_win)
        ctx_row = self.context_group(profile)
        tab_row = self.tab_group(profile)
        media_row = self.media_group()
        spare = (budget - len(ws_row) - len(identity_row) - len(media_row)
                 - len(ctx_row) - len(tab_row))
        win_row = self.window_group(clients, active_win, spare, profile)
        return self.compose(
            [ws_row, identity_row, media_row, ctx_row, tab_row, win_row], trailing)

    def page_apps(self):
        """Live running-app dock followed by controls for the active app."""
        clients, workspaces, active_ws, active_win = self.snapshot()
        profile = self.profile_for(active_win)
        trailing = self.voice_group() + self.mode_group()
        ws_row = self.workspace_group(workspaces, active_ws, True)
        active_address = (active_win or {}).get("address")
        ordered = sorted(
            [c for c in clients if c.get("mapped", True) and not c.get("hidden")],
            key=lambda c: c.get("focusHistoryID", 999),
        )
        # F13-F16 are the four dedicated window-jump keys. Keep the active app
        # first and light it; the rest are most-recently-used order.
        ordered = ordered[:4]
        self.window_slots = [c.get("address") for c in ordered]
        dock = []
        for index, client in enumerate(ordered):
            glyph, color = self.glyph_for(client)
            active = client.get("address") == active_address
            dock.append(spec(
                glyph, None,
                fill="accent" if active else "surface",
                fg="on_accent" if active else color,
                size=30, glow=active,
                daemon="focus:%s" % client.get("address"),
            ))
        # A two-window dock should not leave a desert of black glass. Use the
        # rest for actions belonging to the app that is currently lit, then
        # favicon chips when that app is a browser.
        return self.compose(
            [ws_row, dock, self.context_group(profile), self.tab_group(profile)],
            trailing,
        )

    def page_workspaces(self):
        clients, workspaces, active_ws, _ = self.snapshot()
        current = active_ws.get("id")
        # Show what actually lives on each workspace rather than a bare digit:
        # the glyph of its most recently focused window, numbered in the corner.
        occupant = {}
        for client in sorted(clients, key=lambda c: c.get("focusHistoryID", 999)):
            occupant.setdefault((client.get("workspace") or {}).get("id"), client)
        rows = []
        for index in self.workspace_ids(workspaces):
            top = occupant.get(index)
            glyph, color = self.glyph_for(top) if top else ("\u00b7", "muted")
            active = index == current
            rows.append(spec(
                glyph, None,
                fill="accent" if active else "surface",
                fg="on_accent" if active else color,
                size=30, badge=index,
                daemon="workspace:%d" % index))
        close = spec("", None, fill="sunken", fg="muted", size=24,
                     daemon="page:workspaces")
        return self.compose([rows], [close])

    def page_claude(self):
        """Everything the read-out cannot fit, one tap away."""
        session = self.claude
        close = spec("\uf00d", None, fill="sunken", fg="muted", size=24,
                     daemon="page:claude")
        if session is None:
            return self.compose([[]], [close])

        def tile(value, caption, color):
            return spec(str(value), None, fill="sunken", fg=color, size=21,
                        gloss=False, sub=caption, daemon="page:claude")

        top = sorted(session.tools.items(), key=lambda kv: kv[1], reverse=True)[:3]
        model = re.sub(r"^claude-", "", session.model or "").replace("-", " ")
        rows = [
            spec(model or "-", None, fill="sunken", fg="accent", size=21,
                 gloss=False, sub="model \u25be", daemon="page:models"),
            spec(session.effort or "auto", None, fill="sunken", fg="accent",
                 size=21, gloss=False, sub="effort \u25be", daemon="page:efforts"),
            tile(PERMISSION_LABELS.get(session.permission, session.permission or "-"),
                 "mode", "green"),
            tile(session.turns, "turns", "blue"),
            tile(session.elapsed() or "-", "elapsed", "blue"),
        ]
        rows += [tile(count, name.lower()[:8], "fg") for name, count in top]
        # Context and the rate-limit gauges live on the main bar; this page
        # carries what could not fit beside them.
        rows += [
            tile(compact(session.output), "output", "magenta"),
            tile(compact(session.cache_read), "cached", "magenta"),
            tile(compact(self.totals.total), "all time", "cyan"),
            tile(plan_tier() or "-", "plan", "cyan"),
        ]
        return self.compose([rows], [close])

    def page_chatgpt(self):
        """Expanded ChatGPT/Codex activity panel, opened from any live tile."""
        data = self.chatgpt_stats
        close = spec("\uf00d", None, fill="sunken", fg="muted", size=24,
                     daemon="page:chatgpt")

        def tile(value, caption, color, gauge=None):
            extra = {"daemon": "page:chatgpt"}
            if gauge is not None:
                extra.update(gauge=max(0.0, min(1.0, gauge)), bar=color,
                             track="darker_background")
            return spec(str(value), None, fill="sunken", fg=color, size=20,
                        gloss=False, sub=caption, **extra)

        context = int(data.get("context") or 0)
        limit = int(data.get("context_limit") or 0)
        usage = data.get("usage")
        secondary = data.get("secondary_usage")
        rows = [
            tile("live" if self.chatgpt_thinking else "ready", "status",
                 "green" if not self.chatgpt_thinking else "accent"),
            tile(data.get("model") or "-", "model", "accent"),
            tile(data.get("effort") or "-", "effort", "cyan"),
            tile(compact(context), "context", "fg",
                 context / float(limit) if limit else 0),
            tile(compact(limit), "window", "muted"),
            tile(compact(data.get("output")), "output", "magenta"),
            tile(data.get("turns", 0), "turns", "blue"),
            tile(data.get("tools", 0), "tools", "yellow"),
            tile(data.get("active_for") or "-", "elapsed", "blue"),
            tile("%d%%" % usage if usage is not None else "--", "5 hour",
                 "green" if usage is None or usage < 50 else
                 "yellow" if usage < 80 else "red",
                 usage / 100.0 if usage is not None else 0),
            tile("%d%%" % secondary if secondary is not None else "--", "weekly",
                 "green" if secondary is None or secondary < 50 else
                 "yellow" if secondary < 80 else "red",
                 secondary / 100.0 if secondary is not None else 0),
            tile(data.get("active_tasks", 0), "tasks", "cyan"),
        ]
        return self.compose([rows], [close])

    def choice_page(self, choices, current, kind):
        """One tap per option. Switching drives a slash command through the
        keyboard, so it is only offered while the session is idle."""
        session = self.claude
        idle = session is not None and not session.busy
        close = spec("\uf00d", None, fill="sunken", fg="muted", size=24,
                     daemon="page:%s" % kind)
        rows = []
        for choice in choices:
            active = choice == current
            rows.append(spec(
                choice, None,
                fill="accent" if active else "surface",
                fg="on_accent" if active else ("fg" if idle else "muted"),
                size=21, sub=kind[:-1] if active else "",
                sub_fg="on_accent",
                daemon=("%s:%s" % (kind[:-1], choice)) if idle and not active else None))
        return self.compose([rows], [close])

    def page_models(self):
        current = ""
        if self.claude and self.claude.model:
            for alias in MODEL_CHOICES:
                if alias in self.claude.model:
                    current = alias
                    break
        return self.choice_page(MODEL_CHOICES, current, "models")

    def page_efforts(self):
        current = (self.claude.effort if self.claude else "") or "auto"
        return self.choice_page(EFFORT_CHOICES, current, "efforts")

    def page_fn(self):
        rows = [spec("F%d" % n, "F%d" % n, fill="surface", fg="fg", size=22)
                for n in range(1, 13)]
        return self.compose([rows], self.mode_group())

    def page_system(self):
        """Live machine vitals, re-read every couple of seconds while open."""
        stats = self.stats
        stats.refresh(interval=1.0)

        def tile(value, caption, color, gauge=None):
            extra = {}
            if gauge is not None:
                extra.update(gauge=max(0.0, min(1.0, gauge)), bar=color,
                             track="darker_background")
            return spec(str(value), None, fill="sunken", fg=color, size=20,
                        gloss=False, sub=caption, **extra)

        rows = []
        if stats.battery:
            percent, status = stats.battery
            plugged = status in ("Charging", "Full", "Not charging")
            color = ("green" if plugged else
                     "red" if percent <= 15 else
                     "yellow" if percent <= 40 else "fg")
            rows.append(tile("%d%%" % percent,
                             ("battery " + status).strip().lower(),
                             color, percent / 100.0))
        cpu = int(round(stats.cpu * 100))
        rows.append(tile("%d%%" % cpu, "cpu",
                         "green" if cpu < 50 else "yellow" if cpu < 85 else "red",
                         stats.cpu))
        rows.append(tile("%.2f" % stats.load, "load", "blue"))
        mem = int(round(stats.mem_frac * 100))
        rows.append(tile("%d%%" % mem,
                         "ram %s/%s" % (human_kb(stats.mem_used),
                                        human_kb(stats.mem_total)),
                         "green" if mem < 60 else "yellow" if mem < 85 else "red",
                         stats.mem_frac))
        if stats.swap_total:
            swap = int(round(stats.swap_frac * 100))
            rows.append(tile("%d%%" % swap,
                             "swap %s/%s" % (human_kb(stats.swap_used),
                                             human_kb(stats.swap_total)),
                             "green" if swap < 10 else "yellow" if swap < 30
                             else "red",
                             stats.swap_frac))
        if stats.temp is not None:
            rows.append(tile("%d°" % round(stats.temp), "cpu temp",
                             "green" if stats.temp < 70 else
                             "yellow" if stats.temp < 85 else "red",
                             stats.temp / 100.0))
        for index, (rpm, top) in enumerate(stats.fans):
            rows.append(tile(rpm, "fan %d rpm" % (index + 1), "cyan",
                             rpm / float(top) if top else None))
        return self.compose([rows], self.mode_group())

    def page_settings(self):
        """Mac-style hardware controls: icons only, no old metric gauges."""
        stats = self.stats
        stats.refresh_controls(interval=1.0)

        def button(glyph, action, color="fg", size=28):
            return spec(glyph, None, fill="surface", fg=color, size=size,
                        daemon=action)

        muted = bool(stats.volume and stats.volume[1])
        rows = [
            button("󰃞", "sys:bright-", size=22),
            button("󰃠", "sys:bright+", size=32),
            button("󰍹", "sys:bright-toggle", "yellow", 27),
            button("󰌌", "sys:kbd-", size=21),
            button("󰌌", "sys:kbd+", size=31),
            button("󰌐", "sys:kbd-toggle", "cyan", 27),
            button("󰒮", "media:previous"),
            button("󰐊", "media:playpause", "green", 29),
            button("󰒭", "media:next"),
            button("󰖁", "sys:mute", "red" if muted else "fg"),
            button("󰕿", "sys:vol-"),
            button("󰕾", "sys:vol+", size=30),
        ]
        return self.compose([rows], self.mode_group())

    def goal_specs(self, payload, progress=1.0):
        count = int(self.config["settings"]["slots"])
        metrics = layout_metrics([BLANK] * count)[1:]
        return [spec("", None, fill="darker_background", fg="bright_foreground",
                     gloss=False, goal_scene=dict(payload, progress=progress),
                     scene_x=left, bar="accent", goal_red="red")
                for left, _width in metrics]

    def enqueue_goal(self, payload):
        with self.lock:
            identity = payload.get("id")
            if identity and (identity == (self.goal_active or {}).get("id") or
                             any(identity == g.get("id") for g in self.goal_queue)):
                return
            self.goal_queue.append(payload)
            if self.goal_animating:
                return
            self.goal_animating = True
        threading.Thread(target=self._goal_worker, daemon=True).start()

    @staticmethod
    def ack_goal(payload):
        identity = payload.get("id")
        if not identity:
            return
        try:
            os.makedirs(os.path.dirname(GOAL_ACKS), exist_ok=True)
            with open(GOAL_ACKS, "a") as handle:
                handle.write(identity + "\n")
                handle.flush()
                os.fsync(handle.fileno())
        except OSError:
            pass

    def _goal_worker(self):
        while True:
            with self.lock:
                if not self.goal_queue:
                    self.goal_active = None
                    self.goal_animating = False
                    self.last_written = None
                    self.prev_specs = []
                    break
                self.goal_active = self.goal_queue.popleft()
                payload = dict(self.goal_active)
                self.generation += 1
            started = time.monotonic()
            for frame_no in range(19):
                progress = frame_no / 18.0
                specs = self.goal_specs(payload, progress)
                self.queue(self.to_toml(specs), actions=[None] * 14,
                           hit_regions=self.hit_regions(specs, [None] * 14))
                target = started + progress * 1.25
                time.sleep(max(0, target - time.monotonic()))
            end = started + 5.0
            while time.monotonic() < end:
                time.sleep(min(.1, max(0, end - time.monotonic())))
            self.ack_goal(payload)       # durable acknowledgement after display
        self.render(allow_animation=False)

    def specs(self):
        self.browser_active = False
        if self.voice_state != "idle":
            return self.voice_overlay()
        if self.page == "fn":
            return self.page_fn()
        if self.page == "apps":
            return self.page_apps()
        if self.page == "workspaces":
            return self.page_workspaces()
        if self.page == "claude":
            return self.page_claude()
        if self.page == "models":
            return self.page_models()
        if self.page == "efforts":
            return self.page_efforts()
        if self.page == "chatgpt":
            return self.page_chatgpt()
        if self.page == "system":
            return self.page_system()
        if self.page == "settings":
            return self.page_settings()
        return self.page_auto()

    # -- output -----------------------------------------------------------
    def to_toml(self, specs, scale_at=None):
        settings = self.config["settings"]
        radius = int(settings["corner_radius"])
        rows = []
        metrics = layout_metrics(specs)[1:]
        for index, (item, (_, width)) in enumerate(zip(specs, metrics)):
            stretch = max(1, int(item.get("stretch", 1) or 1))
            if item.get("spacer"):
                rows.append("    { Stretch = %d }," % stretch)
                continue
            if item.get("time"):
                rows.append('    { Time = %s, Action = "Time", Stretch = %d },'
                            % (toml_string(item["time"]), stretch))
                continue
            if item.get("battery"):
                rows.append('    { Battery = %s, Action = "Battery", Stretch = %d },'
                            % (toml_string(item["battery"]), stretch))
                continue
            painted = dict(item)
            painted["fill"] = self.palette.color(item["fill"], "surface")
            painted["fg"] = self.palette.color(item["fg"], "fg")
            painted["badge_fill"] = self.palette.color("sunken")
            painted["badge_fg"] = self.palette.color("fg")
            if item.get("goal_red"):
                painted["goal_red"] = self.palette.color(item["goal_red"], "red")
            for field, fallback in (("bar", "accent"), ("track", "sunken"),
                                    ("sub_fg", "muted")):
                if item.get(field):
                    painted[field] = self.palette.color(item[field], fallback)
                elif field != "sub_fg":
                    painted[field] = self.palette.color(fallback)
                else:
                    painted[field] = self.palette.color("muted")
            scale = (scale_at or {}).get(index, 1.0)
            name = self.icons.store(
                build_svg(painted, width, radius, settings["font"], scale)
            )
            fields = ["Icon = %s" % toml_string(name or "search")]
            fields.append("IconWidth = %d" % int(width))
            fields.append("IconHeight = %d" % BAR_HEIGHT)
            if stretch != 1:
                fields.append("Stretch = %d" % stretch)
            rows.append("    { %s }," % ", ".join(fields))
        return emit(settings, rows)

    @staticmethod
    def hit_regions(specs, actions):
        # Claim half of each spacing gap for the buttons either side, so a tap
        # landing between two pills still hits the nearer one.
        half = BUTTON_SPACING / 2.0
        return [
            {"left": left - half, "right": left + width + half, "index": index,
             "action": actions[index] if index < len(actions) else None}
            for index, (left, width) in enumerate(layout_metrics(specs))
        ]

    def action_at_pixel(self, pixel_x):
        for region in self.touch_regions:
            if region["left"] <= pixel_x <= region["right"]:
                return region["index"], region["action"]
        return None, None

    def render(self, allow_animation=True):
        with self.lock:
            self.reload_if_changed()
            if self.goal_active is not None:
                return
            specs = self.specs()
            actions = [None] + [
                item.get("daemon")
                or ("keys:%s" % item["keys"] if item.get("keys") else None)
                for item in specs
            ]
            hit_regions = self.hit_regions(specs, actions)
            changed = [
                i for i, item in enumerate(specs)
                if i >= len(self.prev_specs) or self.prev_specs[i] != item
            ]
            animate = bool(allow_animation) and bool(changed) and bool(self.prev_specs) \
                and self.config["settings"].get("animate", True) \
                and self.voice_state not in ("recording", "transcribing") \
                and not (self.claude is not None and self.claude.busy)
            self.prev_specs = specs
            self.generation += 1
            generation = self.generation
        if animate:
            threading.Thread(
                target=self._animate,
                args=(generation, specs, changed, actions, hit_regions), daemon=True
            ).start()
        else:
            self.queue(self.to_toml(specs), actions=actions,
                       hit_regions=hit_regions)

    def _animate(self, generation, specs, changed, actions, hit_regions):
        """Pop the buttons that changed. Frames are whole repaints, so this
        costs three reloads regardless of how many buttons moved."""
        for scale in ANIMATION_FRAMES:
            if generation != self.generation:
                return
            self.queue(self.to_toml(specs, {i: scale for i in changed}),
                       generation, actions, hit_regions)
            time.sleep(ANIMATION_STEP)
        self.queue(self.to_toml(specs), generation, actions, hit_regions)

    def queue(self, text, generation=None, actions=None, hit_regions=None):
        with self.write_lock:
            if generation is not None and generation != self.generation:
                return
            if text == self.last_written and actions == self.touch_actions:
                return
            if self.pending is None:
                self.pending_since = time.monotonic()
            self.pending = text
            self.pending_actions = actions
            self.pending_hit_regions = hit_regions
        self.flush()

    def touch_settled(self):
        if self.pending_since and time.monotonic() - self.pending_since > GATE_TIMEOUT:
            return True                 # watchdog: never stall the bar
        return not self.fn_down and not self.touch_down and (
            time.monotonic() - self.touch_released_at > TOUCH_GRACE
        )

    def flush(self):
        """Write once no finger is down and Fn is not showing media controls."""
        with self.write_lock:
            if self.pending is None or not self.touch_settled():
                return
            text, self.pending = self.pending, None
            actions, self.pending_actions = self.pending_actions, None
            regions, self.pending_hit_regions = self.pending_hit_regions, None
            self.pending_since = 0.0
            try:
                # In place, not an atomic rename: tiny-dfr watches this inode.
                with open(DFR_CONFIG, "w") as handle:
                    handle.write(text)
                self.last_written = text
                self.last_change = time.monotonic()
                if actions is not None:
                    self.touch_actions = actions
                if regions is not None:
                    self.touch_regions = regions
            except OSError as exc:
                sys.stderr.write("omarchy-touchbar: cannot write %s: %s\n" % (DFR_CONFIG, exc))

    # -- commands ---------------------------------------------------------
    def command(self, line):
        parts = line.strip().split()
        if not parts:
            return "?"
        verb, args = parts[0], parts[1:]
        if verb == "page":
            target = args[0] if args else "next"
            if target == "next":
                base = self.page if self.page in PAGES else "auto"
                self.page = PAGES[(PAGES.index(base) + 1) % len(PAGES)]
            elif target in ("workspaces", "claude", "chatgpt", "models", "efforts"):
                self.page = "auto" if self.page == target else target
            elif target in PAGES:
                self.page = target
            self.render()
            return self.page
        if verb == "focus":
            try:
                slot = int(args[0]) - 1
            except (IndexError, ValueError):
                return "usage: focus N"
            if 0 <= slot < len(self.window_slots):
                # This Hyprland takes Lua expressions, not the old flat
                # "focuswindow address:0x..." dispatcher string.
                hypr('dispatch hl.dsp.focus({ window = "address:%s" })'
                     % self.window_slots[slot], as_json=False)
                return "ok"
            return "empty slot"
        if verb == "voice":
            action = args[0] if args else "toggle"
            self.voice_action(action)
            return self.voice_state
        if verb == "goal":
            try:
                payload = json.loads(base64.urlsafe_b64decode(args[0] + "===").decode())
            except Exception:
                return "usage: goal BASE64_JSON"
            self.enqueue_goal(payload)
            return "queued"
        if verb == "render":
            self.last_written = None
            self.prev_specs = []
            self.render()
            return "ok"
        if verb == "status":
            return json.dumps({"page": self.page, "windows": self.window_slots,
                               "voice": self.voice_state,
                               "voice_backend": self.voice_backend,
                               "chatgpt_thinking": self.chatgpt_thinking,
                               "chatgpt_usage": self.chatgpt_usage,
                               "chatgpt_stats": self.chatgpt_stats,
                               "browser_tabs": len(self.browser.tabs),
                               "browser_selected": self.browser.selected,
                               "browser_offset": self.browser_offset,
                               "fn_down": self.fn_down,
                               "last_touch": self.last_touch,
                               "goal_active": self.goal_active,
                               "goal_queue": len(self.goal_queue)})
        return "unknown command"

    def active_window(self, max_age=0.3):
        now = time.monotonic()
        if now - self._active_at < max_age:
            return self._active_cache
        win = hypr("activewindow") or {}
        self._active_cache, self._active_at = win, now
        return win

    def focus_browser_tab(self, target):
        count = len(self.browser.tabs)
        if not (0 <= target < count):
            return
        current = min(self.browser.selected, count - 1)
        self.browser.selected = target       # immediate active underline
        self.browser.override = (target, self.browser.file_selected,
                                 time.monotonic() + 25.0)
        self.browser_user_paging_until = 0.0
        self.render(allow_animation=False)

        mods = self.browser.select_mods

        def type_switch():
            if target < 8:
                args = wtype_args("%s+%d" % (mods, target + 1))
                if args:
                    subprocess.run(["wtype"] + args, stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, check=False)
                return
            if target == count - 1:
                args = wtype_args("%s+9" % mods)
                if args:
                    subprocess.run(["wtype"] + args, stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, check=False)
                return
            forward = (target - current) % count
            backward = (current - target) % count
            chord = "CTRL+PAGEDOWN" if forward <= backward else "CTRL+PAGEUP"
            repeats = min(forward, backward)
            args = wtype_args(chord)
            for _ in range(repeats):
                if args:
                    subprocess.run(["wtype"] + args, stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, check=False)
                    time.sleep(0.025)

        threading.Thread(target=type_switch, daemon=True).start()

    def handle_swipe(self, direction):
        """Page the live tab strip while leaving the focused tab untouched."""
        if not self.browser_active or self.browser_capacity <= 0:
            return False
        last_page = ((max(1, len(self.browser.tabs)) - 1)
                     // self.browser_capacity) * self.browser_capacity
        before = self.browser_offset
        if direction == "left":
            self.browser_offset = min(last_page,
                                      self.browser_offset + self.browser_capacity)
        else:
            self.browser_offset = max(0, self.browser_offset - self.browser_capacity)
        self.browser_user_paging_until = time.monotonic() + 8.0
        self.browser_marquee = 0
        if self.browser_offset != before:
            self.prev_specs = []
            self.render(allow_animation=False)
            return True
        return False

    def handle_touch_action(self, action):
        """Dispatch daemon-owned controls directly. No synthetic keyboard
        event exists for these buttons, so workspace and mic cannot collide."""
        if not action:
            return
        kind, _, value = action.partition(":")
        if kind == "workspace":
            hypr('dispatch hl.dsp.focus({ workspace = "%s" })' % value,
                 as_json=False)
            if self.page == "workspaces":
                self.page = "auto"
            self.invalidate_state()
            self.prev_specs = []  # workspace navigation should feel immediate
            self.render()
        elif kind == "page":
            if value == "next":
                base = self.page if self.page in PAGES else "auto"
                self.page = PAGES[(PAGES.index(base) + 1) % len(PAGES)]
            elif value in ("workspaces", "claude", "chatgpt", "models", "efforts"):
                self.page = "auto" if self.page == value else value
            elif value in PAGES:
                self.page = value
            self.prev_specs = []  # no decorative transition on navigation UI
            self.render()
        elif kind == "keys" and value:
            args = wtype_args(value)
            if args:
                subprocess.Popen(["wtype"] + args, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
        elif kind == "browser-tab" and value:
            try:
                self.focus_browser_tab(int(value))
            except ValueError:
                pass
        elif kind == "media":
            if value == "mute":
                self.media.toggle_mute()
            else:
                self.media.call({"playpause": "PlayPause", "next": "Next",
                                 "previous": "Previous"}.get(value, "PlayPause"))
                self.media.checked = 0.0
            self.render()
        elif kind in ("model", "effort") and value:
            self.run_slash("/%s %s" % (kind, value))
            self.page = "auto"
            self.prev_specs = []
            self.render()
        elif kind == "sys" and value:
            self.system_control(value)
        elif kind == "voice":
            self.voice_action(value or "toggle")
        elif kind == "focus" and value:
            hypr('dispatch hl.dsp.focus({ window = "address:%s" })' % value,
                 as_json=False)
            self.invalidate_state()

    def system_control(self, value):
        """Adjust icon-only hardware controls without showing metric tiles."""
        stats = self.stats
        stats.refresh_controls(interval=0.0)
        screen, kbd = stats.backlight_device, stats.kbd_device
        if value == "bright-toggle" and screen:
            if stats.brightness:
                stats.last_screen = stats.brightness
                command = ["brightnessctl", "-d", screen, "s", "0%"]
            else:
                command = ["brightnessctl", "-d", screen, "s",
                           "%d%%" % max(5, stats.last_screen)]
        elif value == "kbd-toggle" and kbd:
            if stats.kbd:
                stats.last_kbd = stats.kbd
                command = ["brightnessctl", "-d", kbd, "s", "0%"]
            else:
                command = ["brightnessctl", "-d", kbd, "s",
                           "%d%%" % max(1, stats.last_kbd)]
        else:
            command = None
        commands = {
            # --min-value keeps a stray tap from turning the screen fully off.
            "bright-": ["brightnessctl", "--min-value=5", "-d", screen,
                        "s", "10%-"] if screen else None,
            "bright+": ["brightnessctl", "-d", screen, "s", "10%+"]
                       if screen else None,
            "kbd-": ["brightnessctl", "-d", kbd, "s", "10%-"] if kbd else None,
            "kbd+": ["brightnessctl", "-d", kbd, "s", "10%+"] if kbd else None,
            "vol-": ["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "5%-"],
            "vol+": ["wpctl", "set-volume", "-l", "1.0",
                     "@DEFAULT_AUDIO_SINK@", "5%+"],
            "mute": ["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"],
        }
        args = command or commands.get(value)
        if not args:
            return
        try:
            subprocess.run(args, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=2, check=False)
        except (OSError, subprocess.SubprocessError) as exc:
            sys.stderr.write("omarchy-touchbar: %s failed: %s\n" % (value, exc))
            return
        stats.controls_checked = 0.0        # reflect the new level immediately
        self.render(allow_animation=False)

    def run_slash(self, command):
        """Type a slash command into the focused Claude Code prompt.

        There is no IPC for this, so it goes through the keyboard. The prompt is
        cleared first - the same Ctrl+A/BackSpace pair clear_dictation uses -
        because a slash command only registers at the start of an empty line.
        """
        try:
            subprocess.run(["wtype", "-M", "ctrl", "-k", "a", "-m", "ctrl",
                            "-k", "BackSpace"], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, check=False)
            subprocess.run(["wtype", command, "-k", "Return"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           check=False)
        except OSError as exc:
            sys.stderr.write("omarchy-touchbar: cannot type %r: %s\n" % (command, exc))

    def toggle_voice(self):
        active = self.active_window()
        address = active.get("address")

        if self.voice_state == "review":
            self.voice_state = "idle"       # Add more continues at the cursor.

        if self.voice_state == "idle":
            self.voice_backend = "voxtype"
            self.voice_target = address
            self.review_until = 0.0
            self.reset_voice_meter()
            subprocess.Popen(["voxtype", "record", "start"],
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
            self.voice_state = "recording"
            self.render()
            return

        if self.voice_state == "recording":
            subprocess.Popen(["voxtype", "record", "stop"],
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
            self.voice_state = "transcribing"
            self.render()

    def voice_action(self, action):
        """Keep recording, review, send, and deletion fully on the Touch Bar."""
        action = (action or "toggle").lower()
        if action in ("toggle", "pause"):
            if action == "toggle" or self.voice_state == "recording":
                self.toggle_voice()
            return
        if action == "add" and self.voice_state == "review":
            self.toggle_voice()
            return
        if action in ("delete", "clear", "cancel"):
            if self.voice_state in ("recording", "transcribing"):
                subprocess.Popen(["voxtype", "record", "cancel"],
                                 stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
                self.voice_state = "idle"
                self.voice_backend = None
                self.voice_target = None
                self.review_until = 0.0
                self.prev_specs = []
                self.render()
            else:
                self.clear_dictation()
            return
        if action == "send" and self.voice_state == "review":
            subprocess.run(["wtype", "-k", "Return"],
                           stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, check=False)
            self.voice_state = "idle"
            self.voice_backend = None
            self.voice_target = None
            self.review_until = 0.0
            self.prev_specs = []
            self.render()

    def clear_dictation(self):
        if self.voice_state != "review":
            return
        # Select and clear the input. This is intentionally routed through a
        # daemon command because tiny-dfr actions are chords, not sequences.
        subprocess.run(["wtype", "-M", "ctrl", "-k", "a", "-m", "ctrl",
                        "-k", "BackSpace"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
        self.voice_state = "idle"
        self.render()


# ------------------------------------------------------------------ preview --
def preview(bar, out="/tmp/omarchy-touchbar-preview.png"):
    """Rasterise the current layout the same way librsvg will on the panel."""
    settings = bar.config["settings"]
    radius = int(settings["corner_radius"])
    specs = bar.specs()
    parts = []
    items = [{"label": "esc", "fill": "sunken",
              "fg": "muted", "size": 20}] + specs
    for item, (left, width) in zip(items, layout_metrics(specs)):
        if item.get("spacer") or item.get("time") or item.get("battery"):
            continue
        painted = dict(item)
        painted["fill"] = bar.palette.color(item["fill"], "surface")
        painted["fg"] = bar.palette.color(item["fg"], "fg")
        body = build_svg(painted, width, radius, settings["font"])
        body = body.replace("<svg ", '<svg x="%.2f" ' % left, 1)
        parts.append(body)
    svg = (
        '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d">'
        '<defs><linearGradient id="g" x1="0" y1="0" x2="0" y2="1">'
        '<stop offset="0" stop-color="#ffffff" stop-opacity="0.10"/>'
        '<stop offset="1" stop-color="#ffffff" stop-opacity="0"/></linearGradient></defs>'
        '<rect width="%d" height="%d" fill="#000000"/>%s</svg>'
        % (BAR_WIDTH, BAR_HEIGHT, BAR_WIDTH, BAR_HEIGHT, "".join(parts))
    )
    source = out + ".svg"
    with open(source, "w") as handle:
        handle.write(svg)
    subprocess.run(["rsvg-convert", "-o", out, source], check=True)
    return out


# ------------------------------------------------------------------ daemon --
def serve(bar):
    if os.path.exists(SOCK_PATH):
        os.unlink(SOCK_PATH)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(SOCK_PATH)
    server.listen(8)
    while True:
        conn, _ = server.accept()
        try:
            data = conn.recv(4096).decode().strip()
            conn.sendall((bar.command(data) + "\n").encode())
        except Exception:                                   # noqa: BLE001
            pass
        finally:
            conn.close()


INTERESTING = (
    "activewindow", "activewindowv2", "workspace", "workspacev2", "focusedmon",
    "openwindow", "closewindow", "movewindow", "createworkspace",
    "destroyworkspace", "urgent", "changefloatingmode", "configreloaded",
)


def watch_hyprland(bar):
    pending = threading.Event()
    kinds = set()
    kinds_lock = threading.Lock()

    def painter():
        focused = None
        while True:
            pending.wait()
            time.sleep(0.04)          # coalesce bursts of events
            pending.clear()
            with kinds_lock:
                seen = set(kinds)
                kinds.clear()
            bar.invalidate_state()
            active = bar.active_window(0)
            address = active.get("address")
            moved = address != focused
            focused = address
            if bar.voice_state == "review" and bar.voice_target \
                    and address != bar.voice_target:
                bar.voice_state = "idle"
                bar.review_until = 0.0
            # Transient pages end with the errand that opened them: landing on
            # a workspace closes the picker, and switching apps drops the
            # Claude/ChatGPT panels. Unrelated events (a window opening on
            # another workspace, a notification) leave them alone.
            if bar.page == "workspaces":
                if moved or seen & {"workspace", "workspacev2", "focusedmon"}:
                    bar.page = "auto"
            elif bar.page in ("claude", "models", "efforts", "chatgpt") and moved:
                bar.page = "auto"
            bar.render()

    threading.Thread(target=painter, daemon=True).start()

    while True:
        sock = _open_hypr_socket(".socket2.sock")
        if sock is None:
            time.sleep(1)
            continue
        # The two-second timeout protects command requests, but the event
        # socket is intentionally idle between compositor changes.  Once the
        # connection succeeds it must remain blocking, otherwise quiet periods
        # create reconnect gaps that can lose the next focus event.
        sock.settimeout(None)
        try:
            buffer = ""
            while True:
                chunk = sock.recv(8192)
                if not chunk:
                    _hypr_problem("event socket closed")
                    break
                buffer += chunk.decode(errors="replace")
                while "\n" in buffer:
                    line, buffer = buffer.split("\n", 1)
                    kind = line.split(">>", 1)[0]
                    if kind in INTERESTING:
                        with kinds_lock:
                            kinds.add(kind)
                        pending.set()
        except (OSError, UnicodeError) as exc:
            _hypr_problem(str(exc))
        finally:
            sock.close()
        time.sleep(1)                 # Hyprland restarted; reconnect


def find_input_device(name):
    """Return the event node for an exact input-device name."""
    block = []
    for line in open("/proc/bus/input/devices"):
        if line.strip():
            block.append(line)
            continue
        text = "".join(block)
        block = []
        if 'N: Name="%s"' % name in text:
            match = re.search(r"Handlers=.*?(event\d+)", text)
            if match:
                return "/dev/input/" + match.group(1)
    return None


def find_digitizer():
    """The Touch Bar's own touch surface, so we can tell when a finger is down."""
    return find_input_device(DIGITIZER_NAME)


def watch_fn(bar):
    """Use a Fn tap as the hardware-dashboard toggle without mid-press reloads."""
    path = find_input_device(KEYBOARD_NAME)
    if not path:
        sys.stderr.write("omarchy-touchbar: no internal keyboard; Fn is ungated\n")
        return
    while True:
        # Event nodes renumber when the T2 re-enumerates after suspend, so a
        # remembered path can go permanently dead. Re-resolve on every
        # (re)connect and keep the old path only while the device is missing.
        path = find_input_device(KEYBOARD_NAME) or path
        try:
            with open(path, "rb", buffering=0) as handle:
                while True:
                    data = handle.read(INPUT_EVENT.size)
                    if not data or len(data) < INPUT_EVENT.size:
                        break
                    _, _, etype, code, value = INPUT_EVENT.unpack(data)
                    if etype != EV_KEY or code != KEY_FN:
                        continue
                    if value == 1:
                        bar.fn_down = True
                        bar.toggle_fn_dashboard()
                    elif value == 0:
                        bar.fn_down = False
                        bar.touch_released_at = time.monotonic()
                        bar.flush()
        except OSError:
            bar.fn_down = False
        time.sleep(2)


def watch_touches(bar):
    path = find_digitizer()
    if not path:
        sys.stderr.write("omarchy-touchbar: no Touch Bar digitizer; repaints are ungated\n")
        return
    raw_x = None
    start_x = None
    started_at = 0.0
    while True:
        # Same trap as watch_fn: the digitizer's event node renumbers across
        # suspend, and reopening the stale path would ignore touches forever.
        path = find_digitizer() or path
        try:
            with open(path, "rb", buffering=0) as handle:
                while True:
                    data = handle.read(INPUT_EVENT.size)
                    if not data or len(data) < INPUT_EVENT.size:
                        break
                    _, _, etype, code, value = INPUT_EVENT.unpack(data)
                    if etype == EV_ABS and code in (ABS_X, ABS_MT_POSITION_X):
                        raw_x = value
                    if etype == EV_KEY and code == BTN_TOUCH:
                        if value:
                            if not bar.touch_down:
                                start_x = raw_x
                                started_at = time.monotonic()
                            bar.touch_down = True
                        else:
                            bar.touch_down = False
                            bar.touch_released_at = time.monotonic()
                            if raw_x is not None:
                                pixel_x = max(0.0, min(BAR_WIDTH - 0.01,
                                    raw_x / 32767.0 * BAR_WIDTH))
                                elapsed = time.monotonic() - started_at
                                delta = raw_x - start_x if start_x is not None else 0
                                swiped = abs(delta) >= SWIPE_THRESHOLD_RAW \
                                    and elapsed <= SWIPE_MAX_SECONDS
                                if swiped:
                                    direction = "left" if delta < 0 else "right"
                                    bar.last_touch = {
                                        "raw_x": raw_x, "swipe": direction,
                                        "delta": delta,
                                    }
                                    try:
                                        bar.handle_swipe(direction)
                                    except Exception as exc:
                                        sys.stderr.write(
                                            "omarchy-touchbar: swipe failed: %s\n" % exc)
                                else:
                                    index, action = bar.action_at_pixel(pixel_x)
                                    if index is None:
                                        continue
                                    bar.last_touch = {
                                        "raw_x": raw_x, "slot": index,
                                        "action": action,
                                    }
                                    if action:
                                        sys.stderr.write(
                                            "omarchy-touchbar: raw touch slot=%d action=%s\n"
                                            % (index, action))
                                    try:
                                        bar.handle_touch_action(action)
                                    except Exception as exc:  # keep touch thread alive
                                        sys.stderr.write(
                                            "omarchy-touchbar: touch action failed: %s\n" % exc)
        except OSError:
            pass
        bar.touch_down = False          # never latch the gate across a reconnect
        time.sleep(2)


def watch_media(bar):
    """Poll MPRIS off the animation path: busctl blocks for most of a second
    when the system is loaded, and a stall here must not freeze the spinner."""
    was_active = False
    while True:
        bar.media.refresh(interval=0)
        if bar.media.active != was_active:
            was_active = bar.media.active
            bar.render()          # transport appeared or disappeared
        time.sleep(1.5 if bar.media.active else 3.0)


def watch_browser(bar):
    """Refresh live tabs and advance long-title marquee frames."""
    while True:
        active = bar.active_window()
        profile = bar.profile_for(active)
        if profile.get("name") == "Browser" and bar.page == "auto":
            changed = bar.browser.refresh(active)
            if changed:
                bar.browser_marquee = 0
                bar.render(allow_animation=False)
            elif bar.browser_active and bar.browser_has_marquee:
                bar.browser_marquee += 1
                bar.render(allow_animation=False)
        time.sleep(BROWSER_POLL)


def watch_system(bar):
    """Keep the system and settings pages current while they are showing."""
    while True:
        if bar.page == "system":
            bar.stats.refresh(interval=1.5)
            bar.render(allow_animation=False)
        elif bar.page == "settings":
            # Levels can move underneath us (volume keys, ambient sensor).
            if bar.stats.refresh_controls(interval=1.5):
                bar.render(allow_animation=False)
        time.sleep(2.0)


def keep_awake(bar):
    """Hold the Touch Bar lit while something is actually happening.

    tiny-dfr dims the panel 30 s after the last libinput event and blacks it out
    at 60 s (BRIGHTNESS_DIM_TIMEOUT / BRIGHTNESS_OFF_TIMEOUT). Dictating a long
    message or watching Claude work involves no input at all, so the bar goes
    dark exactly when you are looking at it. tiny-dfr only writes the backlight
    when its own computed value changes, so re-asserting full brightness here
    sticks between its transitions.

    Needs write access to the backlight attribute; without the udev rule from
    install.sh this quietly does nothing.
    """
    try:
        with open(os.path.join(TOUCHBAR_BACKLIGHT, "max_brightness")) as handle:
            full = str(int(handle.read().strip()))
    except (OSError, ValueError):
        return
    path = os.path.join(TOUCHBAR_BACKLIGHT, "brightness")
    complained = False
    while True:
        recent = time.monotonic() - bar.last_change < AWAKE_AFTER_CHANGE
        busy = recent or bar.voice_state in ("recording", "transcribing") \
            or (bar.claude is not None and bar.claude.busy)
        if busy:
            try:
                with open(path, "w") as handle:
                    handle.write(full)
            except OSError as exc:
                if not complained:
                    complained = True
                    sys.stderr.write(
                        "omarchy-touchbar: cannot hold the backlight on (%s); "
                        "re-run install.sh to add the udev rule\n" % exc)
        time.sleep(2)


def drain(bar):
    """Write out layouts that were held back while the bar was being touched."""
    while True:
        time.sleep(0.03)
        bar.flush()


def watch_voxtype(bar):
    """Mirror Omarchy's real dictation states into the Touch Bar."""
    previous = "idle"
    while True:
        try:
            with open(VOXTYPE_STATE) as handle:
                state = handle.read().strip() or "idle"
        except OSError:
            state = "idle"
        if state != previous:
            if state in ("recording", "transcribing"):
                if bar.voice_backend in (None, "voxtype"):
                    bar.voice_backend = "voxtype"
                    if state == "recording" and previous != "recording":
                        bar.reset_voice_meter()
                    bar.voice_state = state
                    if not bar.voice_target:
                        bar.voice_target = bar.active_window().get("address")
                    bar.render()
            elif previous == "transcribing" and bar.voice_backend == "voxtype":
                bar.voice_state = "review"
                bar.review_until = 0.0
                bar.prev_specs = []
                bar.render()
            elif previous == "recording" and bar.voice_backend == "voxtype":
                bar.voice_state = "idle"
                bar.render()
            previous = state
        time.sleep(0.08)


def watch_voice_levels(bar):
    """Read Voxtype's 100 Hz min/max microphone frames for the Touch Bar."""
    while True:
        try:
            stream = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            stream.settimeout(3.0)
            stream.connect(VOXTYPE_AUDIO)
            stream.settimeout(None)
            pending = bytearray()
            with stream:
                while True:
                    chunk = stream.recv(4096)
                    if not chunk:
                        break
                    pending.extend(chunk)
                    while len(pending) >= AUDIO_LEVEL_FRAME.size:
                        packed = bytes(pending[:AUDIO_LEVEL_FRAME.size])
                        del pending[:AUDIO_LEVEL_FRAME.size]
                        _, minimum, maximum, peak_dbfs = \
                            AUDIO_LEVEL_FRAME.unpack(packed)
                        if bar.voice_state == "recording":
                            bar.ingest_voice_level(minimum, maximum, peak_dbfs)
        except OSError:
            pass
        time.sleep(0.5)


CODEX_SESSION_CACHE = {}


def codex_session_summary(path):
    """Cache slow-changing, non-message session fields for five seconds."""
    cached = CODEX_SESSION_CACHE.get(path)
    if cached and time.monotonic() - cached[0] < 5:
        return cached[1]
    summary = {"model": "", "effort": "", "turns": 0,
               "active_started": 0.0}
    try:
        with open(path, errors="replace") as handle:
            for line in handle:
                try:
                    payload = json.loads(line).get("payload") or {}
                except json.JSONDecodeError:
                    continue
                event_type = payload.get("type")
                if event_type == "task_started":
                    summary["turns"] += 1
                    summary["active_started"] = stamp_to_epoch(
                        payload.get("started_at"))
                elif event_type in ("task_complete", "turn_aborted"):
                    summary["active_started"] = 0.0
                elif event_type == "thread_settings_applied":
                    settings = payload.get("thread_settings") or {}
                    summary["model"] = settings.get("model") or summary["model"]
                    summary["effort"] = (settings.get("reasoning_effort") or
                                         summary["effort"])
    except OSError:
        pass
    CODEX_SESSION_CACHE[path] = (time.monotonic(), summary)
    return summary


def latest_codex_state():
    """Read numeric/state metadata from recent desktop rollouts.

    Message text and tool arguments are deliberately ignored. The result feeds
    the same kind of live status strip Claude Code gets: work state, context,
    output, turns, tools, model, elapsed time, and real rate-limit gauges.
    """
    paths = glob.glob(os.path.join(HOME, ".codex", "sessions", "**", "*.jsonl"),
                      recursive=True)
    if not paths:
        return {}
    now = time.time()
    stamped = []
    for path in paths:
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            continue
        if now - mtime <= 1800:
            stamped.append((mtime, path))
    stamped.sort(reverse=True)
    newest = None
    active_tasks = 0
    rate = {"usage": None, "secondary_usage": None, "mtime": -1}
    for mtime, path in stamped[:16]:
        try:
            with open(path, "rb") as handle:
                # Ignore guardian/reviewer/subagent rollouts. Their tiny,
                # short-lived model names made the desktop panel jump away
                # from the user's actual ChatGPT/Codex task.
                prefix = handle.read(32768).decode(errors="replace")
                metadata = {}
                for line in prefix.splitlines():
                    try:
                        candidate = json.loads(line).get("payload") or {}
                    except json.JSONDecodeError:
                        continue
                    if candidate.get("session_id"):
                        metadata = candidate
                        break
                source = metadata.get("source")
                if metadata.get("parent_thread_id") or \
                        metadata.get("thread_source") or isinstance(source, dict):
                    continue
                handle.seek(0, os.SEEK_END)
                end = handle.tell()
                handle.seek(max(0, end - 262144))
                raw = handle.read().decode(errors="replace")
        except OSError:
            continue
        static = codex_session_summary(path)
        detail = {
            "model": static["model"], "effort": static["effort"],
            "context": 0, "context_limit": 0,
            "output": 0, "turns": static["turns"], "tools": 0, "tool": "",
            "active_for": "-",
        }
        events = []
        started_at = static["active_started"]
        boundary_line = -1
        line_number = -1
        file_rate = {"usage": None, "secondary_usage": None}
        for line_number, line in enumerate(raw.splitlines()):
            try:
                item = json.loads(line)
            except json.JSONDecodeError:
                continue
            payload = item.get("payload") or {}
            event_type = payload.get("type")
            if event_type in ("task_started", "task_complete", "turn_aborted"):
                events.append(event_type)
                boundary_line = line_number
                if event_type == "task_started":
                    started_at = stamp_to_epoch(payload.get("started_at"))
                else:
                    started_at = 0.0
            if event_type == "thread_settings_applied":
                settings = payload.get("thread_settings") or {}
                detail["model"] = settings.get("model") or detail["model"]
                detail["effort"] = (settings.get("reasoning_effort") or
                                    detail["effort"])
            if event_type in ("function_call", "custom_tool_call"):
                detail["tools"] += 1
                detail["tool"] = (payload.get("name") or "tool").split("__")[-1]
            if event_type == "token_count":
                info = payload.get("info") or {}
                last = info.get("last_token_usage") or {}
                total = info.get("total_token_usage") or {}
                detail["context"] = int(last.get("total_tokens") or 0)
                detail["context_limit"] = int(info.get("model_context_window") or 0)
                detail["output"] = int(total.get("output_tokens") or 0)
                limits = payload.get("rate_limits") or {}
                primary = limits.get("primary") or {}
                secondary = limits.get("secondary") or {}
                if primary.get("used_percent") is not None:
                    file_rate["usage"] = int(round(primary["used_percent"]))
                if secondary.get("used_percent") is not None:
                    file_rate["secondary_usage"] = int(
                        round(secondary["used_percent"]))
        file_active = bool(events) and events[-1] == "task_started"
        # A single tool-heavy turn can push task_started outside the 256 KiB
        # tail. Fresh reasoning/tool events after the last boundary still mean
        # the task is live; task_complete itself remains the clean stop signal.
        if now - mtime < 15:
            file_active = file_active or not events \
                or (line_number - boundary_line > 3)
        if file_active:
            active_tasks += 1
            if started_at:
                seconds = max(0, int(now - started_at))
                detail["active_for"] = ("%dm" % (seconds // 60)
                                        if seconds >= 60 else "%ds" % seconds)
        detail["thinking"] = file_active
        if newest is None:
            newest = detail
        if any(value is not None for value in file_rate.values()) \
                and mtime > rate["mtime"]:
            rate.update(file_rate, mtime=mtime)

    newest = newest or {}
    newest["thinking"] = active_tasks > 0
    newest["active_tasks"] = active_tasks
    newest["usage"] = rate["usage"]
    newest["secondary_usage"] = rate["secondary_usage"]
    return newest


def watch_chatgpt(bar):
    """Animate from actual Codex task events and show real telemetry.

    Scanning the rollout logs is the most expensive poll in the daemon, so it
    only runs while a ChatGPT window is focused, the expanded panel is open,
    or a task it already saw is still live. Anywhere else it costs nothing.
    """
    previous = None
    while True:
        visible = bar.page == "chatgpt" or bool(re.search(
            r"^(chatgpt|ChatGPT)$", bar.active_window().get("class", "") or ""))
        if not visible and not bar.chatgpt_thinking:
            time.sleep(2.5)
            continue
        current = latest_codex_state()
        if current != previous:
            bar.chatgpt_stats = current
            bar.chatgpt_thinking = bool(current.get("thinking"))
            bar.chatgpt_usage = current.get("usage")
            previous = current
            if visible:
                bar.render()
        time.sleep(0.45 if visible else 1.5)


def animate_live_states(bar):
    """Four-frame animation only while something animated is on screen."""
    while True:
        moving = bar.voice_state in ("recording", "transcribing")
        if not moving and bar.media.playing:
            # The equaliser only exists on the auto page's media group.
            moving = bar.page == "auto" and not bar.browser_active
        if not moving and bar.chatgpt_thinking:
            moving = bar.page == "chatgpt" or bool(re.search(
                r"^(chatgpt|ChatGPT)$",
                bar.active_window().get("class", "") or ""))
        if moving:
            bar.voice_phase += 1
            bar.chatgpt_phase += 1
            bar.media_phase += 1
            bar.render()
            time.sleep(0.12 if bar.voice_state == "recording" else 0.24)
        else:
            if bar.voice_state == "review" and bar.review_until \
                    and time.monotonic() > bar.review_until:
                bar.voice_state = "idle"
                bar.review_until = 0.0
                bar.render()
            time.sleep(0.35)


def watch_claude(bar):
    """Drive the spinner while Claude works, and repaint when the tally moves.

    Claude Code appends to its transcript as it goes, so polling that file is
    enough - no hooks and no changes to ~/.claude/settings.json.
    """
    last = None
    while True:
        session = bar.claude_for(bar.active_window())
        if session is None:
            last = None
            time.sleep(0.5)
            continue
        settings = bar.config["settings"]
        if session.busy and settings.get("animate", True):
            # Every frame is a whole config reload (~13 ms of tiny-dfr's CPU),
            # so pace it: four frames at this interval still reads as a spinner.
            bar.claude_phase += 1
            bar.render()
            time.sleep(float(settings.get("claude_spinner", 0.32)))
            continue
        digest = (session.state, session.context, session.output,
                  session.turns, session.permission)
        if digest != last:
            last = digest
            bar.render()
        time.sleep(0.4)


def restore_static():
    """Leave a plain function row behind when the daemon stops."""
    rows = ['    { Text = "F%d", Action = "F%d" },' % (n, n) for n in range(1, 13)]
    rows += ["    { Stretch = 1 },"] * (int(DEFAULTS["settings"]["slots"]) - len(rows))
    settings = dict(DEFAULTS["settings"])
    try:
        with open(DFR_CONFIG, "w") as handle:
            handle.write(emit(settings, rows).replace(
                "ShowButtonOutlines = false", "ShowButtonOutlines = true"))
    except OSError:
        pass


def watch_goals(bar):
    """Replay every unacknowledged goal; never remove before it is displayed."""
    while True:
        events = []
        try:
            try:
                with open(GOAL_ACKS) as handle:
                    acked = {line.strip() for line in handle if line.strip()}
            except OSError:
                acked = set()
            try:
                with open(GOAL_INBOX) as handle:
                    lines = handle.readlines()
            except OSError:
                lines = []
            for line in lines:
                try:
                    event = json.loads(line)
                    if event.get("kind") == "goal" and event.get("id") not in acked:
                        events.append(event)
                except (TypeError, ValueError):
                    continue
        except OSError:
            pass
        for event in events:
            bar.enqueue_goal(event)
        time.sleep(.35)


def run_daemon():
    bar = TouchBar(clear_cache=True)

    def bye(*_):
        restore_static()
        sys.exit(0)

    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)
    threading.Thread(target=watch_fn, args=(bar,), daemon=True).start()
    threading.Thread(target=watch_touches, args=(bar,), daemon=True).start()
    threading.Thread(target=drain, args=(bar,), daemon=True).start()
