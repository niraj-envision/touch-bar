class TouchBar:
    def __init__(self, clear_cache=False):
        self.config = load_config()
        self.palette = Palette(load_toml(THEME_COLORS, FALLBACK_THEME))
        self.stamps = self._stamps()
        self.icons = IconCache(clear=clear_cache)
        self.page = "auto"
        self.window_slots = []
        self.last_written = None
        self.prev_specs = []
        self.generation = 0
        self.lock = threading.Lock()
        self.write_lock = threading.Lock()
        self.pending = None
        self.pending_actions = None
        self.touch_actions = [None] * (int(self.config["settings"]["slots"]) + 1)
        self.last_touch = None
        self.touch_down = False
        self.touch_released_at = 0.0
        # A config write resets tiny-dfr to its primary layer. Hold every
        # repaint while the physical Fn key exposes the classic media layer.
        self.fn_down = False
        self.voice_state = "idle"
        self.voice_backend = None
        self.voice_target = None
        self.voice_phase = 0
        self.review_until = 0.0
        self.chatgpt_stats = {}
        self.chatgpt_thinking = False
        self.chatgpt_usage = None
        self.chatgpt_phase = 0
        self.claude = None            # ClaudeSession for the focused window
        self.claude_phase = 0
        self.claude_probe = (None, 0.0, None)   # (window pid, checked at, claude pid)
        self.totals = ClaudeTotals()
        self.limits = UsageLimits()
        self.media = MediaState()
        self.media_phase = 0

    def _stamps(self):
        out = []
        for path in (USER_CONFIG, THEME_COLORS):
            try:
                out.append(os.stat(path).st_mtime)
            except OSError:
                out.append(0)
        return out

    def reload_if_changed(self):
        stamps = self._stamps()
        if stamps != self.stamps:
            self.config = load_config()
            self.palette = Palette(load_toml(THEME_COLORS, FALLBACK_THEME))
            self.stamps = stamps
            self.last_written = None      # colours may have changed everywhere

    # -- state ------------------------------------------------------------
    def snapshot(self):
        return (
            hypr("clients") or [],
            hypr("workspaces") or [],
            hypr("activeworkspace") or {},
            hypr("activewindow") or {},
        )

    def claude_pid(self, active_win):
        """The `claude` process running under this window, if there is one."""
        pid = (active_win or {}).get("pid")
        if not pid:
            return None
        known_pid, checked, found = self.claude_probe
        if known_pid == pid and time.monotonic() - checked < 2.0:
            return found
        found = descendant_named(int(pid), "claude")
        self.claude_probe = (pid, time.monotonic(), found)
        return found

    def claude_cwd(self, active_win):
        pid = self.claude_pid(active_win)
        if not pid:
            return None
        try:
            return os.readlink("/proc/%d/cwd" % pid)
        except OSError:
            return None

    def claude_for(self, active_win):
        """Keep a reader alive for whichever session is on screen."""
        pid = self.claude_pid(active_win)
        if not pid:
            self.claude = None
            return None
        record = session_status(pid)
        cwd = record.get("cwd") or self.claude_cwd(active_win)
        path = None
        if cwd and record.get("sessionId"):
            exact = os.path.join(HOME, ".claude", "projects",
                                 cwd.replace("/", "-"), record["sessionId"] + ".jsonl")
            path = exact if os.path.exists(exact) else None
        if path is None and cwd:
            path = transcript_for(cwd)
        if not path:
            self.claude = None
            return None
        if self.claude is None or self.claude.path != path:
            self.claude = ClaudeSession(path)
        self.claude.refresh()
        # Claude Code publishes its own busy flag; trust it over the tail read.
        self.claude.reported = record.get("status") or ""
        self.claude.name = record.get("name") or ""
        self.totals.refresh()
        self.limits.refresh()
        return self.claude

    def claude_profile(self):
        for profile in self.config["profiles"]:
            if profile.get("claude"):
                return profile
        return None

    def profile_for(self, active_win):
        active_win = active_win or {}
        claude_profile = self.claude_profile()
        if claude_profile is not None and self.claude_cwd(active_win):
            return claude_profile
        window_class = active_win.get("class", "") or ""
        title = active_win.get("title", "") or ""
        tags = [t.rstrip("*") for t in (active_win.get("tags") or [])]
        for profile in self.config["profiles"]:
            try:
                tag_pattern = profile.get("match_tag")
                if tag_pattern and any(re.search(tag_pattern, t, re.I) for t in tags):
                    return profile
                pattern = profile.get("match")
                if pattern and re.search(pattern, window_class, re.I):
                    return profile
                title_pattern = profile.get("match_title")
                if title_pattern and re.search(title_pattern, title, re.I):
                    return profile
            except re.error:
                continue
        for profile in self.config["profiles"]:
            if profile.get("default"):
                return profile
        return {}

    def workspace_ids(self, workspaces):
        settings = self.config["settings"]
        occupied = [w.get("id", 0) for w in workspaces if w.get("id", 0) > 0]
        highest = max(occupied) if occupied else int(settings["workspaces"])
        count = max(int(settings["workspaces"]),
                    min(highest, int(settings["max_workspaces"])))
        return list(range(1, count + 1))

    # -- groups -----------------------------------------------------------
    def workspace_group(self, workspaces, active_ws, collapsed):
        current = active_ws.get("id")
        ids = self.workspace_ids(workspaces)
        populated = {w.get("id"): w.get("windows", 0) for w in workspaces}
        if collapsed:
            # Folded into one pill so the app keeps the width; tap opens the
            # picker. The dot row still shows where you are at a glance.
            dots = "".join("\u25cf" if index == current else "\u25cb"
                           for index in ids)
            return [spec(str(current or 1), None, fill="accent", fg="on_accent",
                         size=27, sub=dots, sub_fg="on_accent", sub_size=12,
                         daemon="page:workspaces")]
        rows = []
        for index in ids:
            active = index == current
            windows = populated.get(index, 0)
            rows.append(spec(
                str(index), None,
                fill="accent" if active else "surface",
                fg="on_accent" if active else ("fg" if windows else "muted"),
                size=27, badge=(windows or None),
                daemon="workspace:%d" % index,
            ))
        return rows

    def media_group(self):
        """Transport for whatever is playing, anywhere. Costs nothing when
        silent, and displaces the typing shortcuts rather than the read-out."""
        if not self.media.active:
            return []
        if self.media.playing:
            lead = spec("", None, fill="accent", fg="on_accent",
                        bars=EQUALIZER[self.media_phase % len(EQUALIZER)],
                        daemon="media:playpause")
        else:
            lead = spec("\uf04b", None, fill="sunken", fg="green", size=24,
                        daemon="media:playpause")
        return [
            spec("\uf048", None, fill="sunken", fg="fg", size=22,
                 daemon="media:previous"),
            lead,
            spec("\uf051", None, fill="sunken", fg="fg", size=22,
                 daemon="media:next"),
            spec("\uf028", None, fill="sunken",
                 fg="red" if self.media.muted else "fg", size=22,
                 sub="muted" if self.media.muted else "", sub_fg="red",
                 daemon="media:mute"),
        ]

    def limit_tile(self, kind, caption):
        """Headroom left on one rate-limit bucket, with its reset countdown."""
        info = self.limits.get(kind)
        if not info or info.get("percent") is None:
            return spec("\u2013", None, fill="sunken", fg="muted", size=21,
                        gloss=False, sub=caption)
        left = max(0, 100 - int(info["percent"]))
        if info.get("severity") in ("warning", "critical"):
            color = "red"
        else:
            color = "green" if left > 40 else "yellow" if left > 15 else "red"
        when = until(info.get("resets_at"))
        return spec("%d%%" % left, None, fill="sunken",
                    fg="muted" if self.limits.stale() else color,
                    size=27, gloss=False,
                    sub="%s %s" % (caption, when) if when else caption)

    def claude_tiles(self, session):
        """Live session read-out: what it is doing, and what it has spent."""
        settings = self.config["settings"]
        if session is None:
            return [spec("\uf0e7", None, fill="sunken", fg="muted",
                         size=26, sub="claude")]
        if session.busy:
            frame = SPINNER[self.claude_phase % len(SPINNER)]
            caption = (session.tool or "thinking").lower()[:9]
            lead = spec(frame, None, fill="accent", fg="on_accent",
                        size=30, glow=True, sub=caption, sub_fg="on_accent")
        else:
            # Idle: name the model, and make it the shortcut for changing it.
            short = re.sub(r"^claude-", "", session.model or "").replace("-", " ")
            lead = spec(short or "claude", None, fill="sunken", fg="accent",
                        size=21, gloss=False, sub="model \u25be",
                        daemon="page:models")

        limit = int(settings.get("claude_context_limit", 0) or 0)
        if limit <= 0:
            # Nothing in the transcript names the window; infer the 1M variant
            # from a context that a 200k model could never have reached.
            limit = 1_000_000 if session.context > 190_000 else 200_000
        used = min(1.0, session.context / float(limit))
        bar_color = "green" if used < 0.6 else "yellow" if used < 0.85 else "red"
        context = spec("%d%%" % round(used * 100), None, fill="sunken",
                       fg=bar_color, size=27, gloss=False,
                       sub="ctx %s" % compact(session.context))

        # Claude Code caches the real buckets, so the local token budget is now
        # only a fallback for when no model-scoped weekly limit is reported.
        scoped = self.limits.scoped_kind()
        scoped_name = (self.limits.get(scoped) or {}).get("model") or "model"
        if scoped:
            third = self.limit_tile(scoped, scoped_name.lower())
        else:
            week = self.totals.week()
            budget = int(settings.get("claude_weekly_budget", 0) or 0)
            if budget > 0:
                used = min(1.0, week / float(budget))
                third = spec("%d%%" % round((1 - used) * 100), None, fill="sunken",
                             fg="fg", size=21, gloss=False, sub="left", gauge=1 - used,
                             bar=("green" if used < 0.6 else
                                  "yellow" if used < 0.85 else "red"),
                             track="darker_background")
            else:
                third = spec(compact(week), None, fill="sunken", fg="yellow",
                             size=21, gloss=False, sub="week")

        tiles = [
            lead,
            self.limit_tile("session", "session"),
            self.limit_tile("weekly_all", "week"),
            third,
            context,
            spec(compact(self.totals.total), None, fill="sunken", fg="cyan",
                 size=24, gloss=False, sub="lifetime"),
        ]
        # The whole read-out is one big button: tap anywhere to expand it.
        for tile in tiles:
            tile["daemon"] = "page:claude"
        return tiles

    def context_group(self, profile):
        mode = PERMISSION_LABELS.get(
            (self.claude.permission if self.claude else ""), "mode")
        rows = [
            spec(entry.get("label", "").replace("{mode}", mode), entry.get("keys"),
                 fill=entry.get("background", "surface"),
                 fg=entry.get("color", "fg"),
                 size=entry.get("size", 26))
            for entry in profile.get("buttons", [])
        ]
        if profile.get("claude"):
            # The read-out moved to the identity slot so media controls can sit
            # between it and the shortcuts, and so the shortcuts are what gets
            # squeezed when the bar runs out of room.
            return rows
        if profile.get("name") == "ChatGPT":
            return self.chatgpt_tiles() + rows
        return rows

    def chatgpt_tiles(self):
        """Claude-style live telemetry for the ChatGPT/Codex desktop app."""
        data = self.chatgpt_stats
        phases = ("󰔟", "󰔚", "󰔛", "󰔜")
        label = phases[self.chatgpt_phase % len(phases)] \
            if self.chatgpt_thinking else "󰭹"
        caption = (data.get("tool") or
                   ("thinking" if self.chatgpt_thinking else "ready"))[:9]
        lead = spec(label, None,
                    fill="accent" if self.chatgpt_thinking else "sunken",
                    fg="on_accent" if self.chatgpt_thinking else "green",
                    size=29, glow=self.chatgpt_thinking, sub=caption,
                    sub_fg="on_accent" if self.chatgpt_thinking else "muted")

        context = int(data.get("context") or 0)
        limit = int(data.get("context_limit") or 0)
        share = min(1.0, context / float(limit)) if limit else 0.0
        context_color = "green" if share < 0.6 else "yellow" if share < 0.85 else "red"
        context_tile = spec(
            "%d%%" % round(share * 100) if limit else "--",
            None, fill="sunken", fg="fg", size=21, gloss=False,
            sub=compact(context), gauge=share, bar=context_color,
            track="darker_background")

        usage = data.get("usage")
        usage_color = "green" if usage is None or usage < 50 \
            else "yellow" if usage < 80 else "red"
        usage_tile = spec(
            "%d%%" % usage if usage is not None else "--",
            None, fill="sunken", fg=usage_color, size=21, gloss=False,
            sub="usage", gauge=(min(1.0, usage / 100.0) if usage is not None else 0),
            bar=usage_color, track="darker_background")

        tiles = [
            lead,
            context_tile,
            spec(compact(data.get("output")), None, fill="sunken", fg="magenta",
                 size=21, gloss=False, sub="output"),
            spec(str(data.get("turns", 0)), None, fill="sunken", fg="blue",
                 size=21, gloss=False, sub="turns"),
            usage_tile,
        ]
        for tile in tiles:
            tile["daemon"] = "page:chatgpt"
        return tiles

    def app_identity(self, profile, active_win):
        glyph = profile.get("icon")
        color = profile.get("icon_color", "accent")
        if not glyph:
            glyph, color = self.glyph_for(active_win or {})
        return [spec(glyph, None, fill="sunken", fg=color, size=28, glow=True)]

    def voice_backend_for(self, active_win):
        profile = self.profile_for(active_win)
        if profile.get("voice_backend"):
            return profile["voice_backend"]
        if re.search(r"^(chatgpt|ChatGPT)$", (active_win or {}).get("class", "")):
            return "chatgpt"
        return "voxtype"

    def voice_group(self):
        """Mic plus post-dictation controls. F22 is the stateful mic; F21
        clears the current input through the daemon so it can send a sequence."""
        if self.voice_state == "recording":
            colors = ("red", "magenta", "orange")
            return [spec("󰍬", None, fill=colors[self.voice_phase % len(colors)],
                         fg="on_accent", size=29, glow=True,
                         daemon="voice:toggle")]
        if self.voice_state == "transcribing":
            return [spec("", None, fill="yellow", fg="on_accent",
                         size=27, glow=True)]
        if self.voice_state == "review":
            return [
                spec("", "Enter", fill="green", fg="on_accent", size=26),
                spec("", None, fill="red", fg="on_accent", size=25,
                     daemon="voice:clear"),
                spec("", None, fill="accent", fg="on_accent", size=25,
                     daemon="voice:toggle"),
            ]
        return [spec("", None, fill="sunken", fg="magenta", size=27,
                     daemon="voice:toggle")]

    def tab_group(self, profile):
        # Browser APIs do not expose live favicon metadata to Wayland. These
        # deliberately look like favicon chips and retain the useful Ctrl+N
        # direct-jump semantics; the corner number is the tab target.
        glyphs = profile.get("tab_icons", [""])
        colors = profile.get("tab_colors", ["blue", "magenta", "red", "yellow"])
        return [
            spec(glyphs[(n - 1) % len(glyphs)], "CTRL+%d" % n,
                 fill="raised", fg=colors[(n - 1) % len(colors)], size=24,
                 badge=n)
            for n in range(1, int(profile.get("tabs", 0)) + 1)
        ]

    def window_group(self, clients, active_win, budget, profile):
        settings = self.config["settings"]
        limit = profile.get("windows", settings["windows"])
        count = min(int(limit), max(0, budget))
        if count <= 0:
            self.window_slots = []
            return []
        active_address = (active_win or {}).get("address")
        ordered = sorted(
            [c for c in clients if c.get("mapped", True) and not c.get("hidden")],
            key=lambda c: c.get("focusHistoryID", 999),
        )
        ordered = [c for c in ordered if c.get("address") != active_address][:count]
        self.window_slots = [c.get("address") for c in ordered]
        rows = []
        for index, client in enumerate(ordered):
            glyph, color = self.glyph_for(client)
            rows.append(spec(glyph, None, fill="sunken", fg=color,
                             daemon="focus:%s" % client.get("address")))
        return rows

    def glyph_for(self, client):
        window_class = client.get("class", "") or ""
        for pattern, value in self.config["icons"].items():
            try:
                if not re.search(pattern, window_class, re.I):
                    continue
            except re.error:
                continue
            if isinstance(value, (list, tuple)):
                return (value[0], value[1] if len(value) > 1 else "fg")
            return (value, "fg")
        return ((window_class[:1] or "?").upper(), "muted")

    def mode_group(self):
        icons = {"auto": "󰀻", "apps": "", "fn": ""}
        colors = {"auto": "accent", "apps": "green", "fn": "muted"}
        rows = [spec(icons.get(self.page, ""), None,
                     fill="sunken", fg=colors.get(self.page, "muted"), size=24,
                     daemon="page:next")]
        settings = self.config["settings"]
        if settings.get("clock"):
            rows.append({"time": settings["clock"]})
        if settings.get("battery"):
            rows.append({"battery": settings["battery"]})
        return rows

    # -- pages ------------------------------------------------------------
    def compose(self, groups, trailing):
        """Always the same number of buttons, whatever is on the bar."""
        budget = max(1, int(self.config["settings"]["slots"]) - len(trailing))
        rows = []
        for group in groups:
            rows.extend(group[: max(0, budget - len(rows))])
        rows.extend(BLANK for _ in range(budget - len(rows)))
        return rows + trailing

    def page_auto(self):
        clients, workspaces, active_ws, active_win = self.snapshot()
        self.claude_for(active_win)
        profile = self.profile_for(active_win)
        trailing = self.voice_group() + self.mode_group()
        budget = max(1, int(self.config["settings"]["slots"]) - len(trailing))
        ws_row = self.workspace_group(
            workspaces, active_ws, profile.get("collapse_workspaces", False)
        )
        if profile.get("claude"):
            identity_row = self.claude_tiles(self.claude)
        elif profile.get("show_identity") is False:
            identity_row = []
        else:
            identity_row = self.app_identity(profile, active_win)
        ctx_row = self.context_group(profile)
        tab_row = self.tab_group(profile)
        media_row = self.media_group()
        spare = (budget - len(ws_row) - len(identity_row) - len(media_row)
                 - len(ctx_row) - len(tab_row))
        win_row = self.window_group(clients, active_win, spare, profile)
        return self.compose(
            [ws_row, identity_row, media_row, ctx_row, tab_row, win_row], trailing)

    def page_apps(self):
        """Live running-app dock followed by controls for the active app."""
        clients, workspaces, active_ws, active_win = self.snapshot()
        profile = self.profile_for(active_win)
        trailing = self.voice_group() + self.mode_group()
        ws_row = self.workspace_group(workspaces, active_ws, True)
        active_address = (active_win or {}).get("address")
        ordered = sorted(
            [c for c in clients if c.get("mapped", True) and not c.get("hidden")],
            key=lambda c: c.get("focusHistoryID", 999),
        )
        # F13-F16 are the four dedicated window-jump keys. Keep the active app
        # first and light it; the rest are most-recently-used order.
        ordered = ordered[:4]
        self.window_slots = [c.get("address") for c in ordered]
        dock = []
        for index, client in enumerate(ordered):
            glyph, color = self.glyph_for(client)
            active = client.get("address") == active_address
            dock.append(spec(
                glyph, None,
                fill="accent" if active else "surface",
                fg="on_accent" if active else color,
                size=30, glow=active,
                daemon="focus:%s" % client.get("address"),
            ))
        # A two-window dock should not leave a desert of black glass. Use the
        # rest for actions belonging to the app that is currently lit, then
        # favicon chips when that app is a browser.
        return self.compose(
            [ws_row, dock, self.context_group(profile), self.tab_group(profile)],
            trailing,
        )

    def page_workspaces(self):
        clients, workspaces, active_ws, _ = self.snapshot()
        current = active_ws.get("id")
        # Show what actually lives on each workspace rather than a bare digit:
        # the glyph of its most recently focused window, numbered in the corner.
        occupant = {}
        for client in sorted(clients, key=lambda c: c.get("focusHistoryID", 999)):
            occupant.setdefault((client.get("workspace") or {}).get("id"), client)
        rows = []
        for index in self.workspace_ids(workspaces):
            top = occupant.get(index)
            glyph, color = self.glyph_for(top) if top else ("\u00b7", "muted")
            active = index == current
            rows.append(spec(
                glyph, None,
                fill="accent" if active else "surface",
                fg="on_accent" if active else color,
                size=30, badge=index,
                daemon="workspace:%d" % index))
        close = spec("", None, fill="sunken", fg="muted", size=24,
                     daemon="page:workspaces")
        return self.compose([rows], [close])

    def page_claude(self):
        """Everything the read-out cannot fit, one tap away."""
        session = self.claude
        close = spec("\uf00d", None, fill="sunken", fg="muted", size=24,
                     daemon="page:claude")
        if session is None:
            return self.compose([[]], [close])

        def tile(value, caption, color):
            return spec(str(value), None, fill="sunken", fg=color, size=21,
                        gloss=False, sub=caption, daemon="page:claude")

        top = sorted(session.tools.items(), key=lambda kv: kv[1], reverse=True)[:3]
        model = re.sub(r"^claude-", "", session.model or "").replace("-", " ")
        rows = [
            spec(model or "-", None, fill="sunken", fg="accent", size=21,
                 gloss=False, sub="model \u25be", daemon="page:models"),
            spec(session.effort or "auto", None, fill="sunken", fg="accent",
                 size=21, gloss=False, sub="effort \u25be", daemon="page:efforts"),
            tile(PERMISSION_LABELS.get(session.permission, session.permission or "-"),
                 "mode", "green"),
            tile(session.turns, "turns", "blue"),
            tile(session.elapsed() or "-", "elapsed", "blue"),
        ]
        rows += [tile(count, name.lower()[:8], "fg") for name, count in top]
        # Context and the rate-limit gauges live on the main bar; this page
        # carries what could not fit beside them.
        rows += [
            tile(compact(session.output), "output", "magenta"),
            tile(compact(session.cache_read), "cached", "magenta"),
            tile(compact(self.totals.total), "all time", "cyan"),
            tile(plan_tier() or "-", "plan", "cyan"),
        ]
        return self.compose([rows], [close])

    def page_chatgpt(self):
        """Expanded ChatGPT/Codex activity panel, opened from any live tile."""
        data = self.chatgpt_stats
        close = spec("\uf00d", None, fill="sunken", fg="muted", size=24,
                     daemon="page:chatgpt")

        def tile(value, caption, color, gauge=None):
            extra = {"daemon": "page:chatgpt"}
            if gauge is not None:
                extra.update(gauge=max(0.0, min(1.0, gauge)), bar=color,
                             track="darker_background")
            return spec(str(value), None, fill="sunken", fg=color, size=20,
                        gloss=False, sub=caption, **extra)

        context = int(data.get("context") or 0)
        limit = int(data.get("context_limit") or 0)
        usage = data.get("usage")
        secondary = data.get("secondary_usage")
        rows = [
            tile("live" if self.chatgpt_thinking else "ready", "status",
                 "green" if not self.chatgpt_thinking else "accent"),
            tile(data.get("model") or "-", "model", "accent"),
            tile(data.get("effort") or "-", "effort", "cyan"),
            tile(compact(context), "context", "fg",
                 context / float(limit) if limit else 0),
            tile(compact(limit), "window", "muted"),
            tile(compact(data.get("output")), "output", "magenta"),
            tile(data.get("turns", 0), "turns", "blue"),
            tile(data.get("tools", 0), "tools", "yellow"),
            tile(data.get("active_for") or "-", "elapsed", "blue"),
            tile("%d%%" % usage if usage is not None else "--", "5 hour",
                 "green" if usage is None or usage < 50 else
                 "yellow" if usage < 80 else "red",
                 usage / 100.0 if usage is not None else 0),
            tile("%d%%" % secondary if secondary is not None else "--", "weekly",
                 "green" if secondary is None or secondary < 50 else
                 "yellow" if secondary < 80 else "red",
                 secondary / 100.0 if secondary is not None else 0),
            tile(data.get("active_tasks", 0), "tasks", "cyan"),
        ]
        return self.compose([rows], [close])

    def choice_page(self, choices, current, kind):
        """One tap per option. Switching drives a slash command through the
        keyboard, so it is only offered while the session is idle."""
        session = self.claude
        idle = session is not None and not session.busy
        close = spec("\uf00d", None, fill="sunken", fg="muted", size=24,
                     daemon="page:%s" % kind)
        rows = []
        for choice in choices:
            active = choice == current
            rows.append(spec(
                choice, None,
                fill="accent" if active else "surface",
                fg="on_accent" if active else ("fg" if idle else "muted"),
                size=21, sub=kind[:-1] if active else "",
                sub_fg="on_accent",
                daemon=("%s:%s" % (kind[:-1], choice)) if idle and not active else None))
        return self.compose([rows], [close])

    def page_models(self):
        current = ""
        if self.claude and self.claude.model:
            for alias in MODEL_CHOICES:
                if alias in self.claude.model:
                    current = alias
                    break
        return self.choice_page(MODEL_CHOICES, current, "models")

    def page_efforts(self):
        current = (self.claude.effort if self.claude else "") or "auto"
        return self.choice_page(EFFORT_CHOICES, current, "efforts")

    def page_fn(self):
        rows = [spec("F%d" % n, "F%d" % n, fill="surface", fg="fg", size=22)
                for n in range(1, 13)]
        return self.compose([rows], self.mode_group())

    def specs(self):
        if self.page == "fn":
            return self.page_fn()
        if self.page == "apps":
            return self.page_apps()
        if self.page == "workspaces":
            return self.page_workspaces()
        if self.page == "claude":
            return self.page_claude()
        if self.page == "models":
            return self.page_models()
        if self.page == "efforts":
            return self.page_efforts()
        if self.page == "chatgpt":
            return self.page_chatgpt()
        return self.page_auto()

    # -- output -----------------------------------------------------------
    def to_toml(self, specs, scale_at=None):
        settings = self.config["settings"]
        width = cell_width(int(settings["slots"]))
        radius = int(settings["corner_radius"])
        rows = []
        for index, item in enumerate(specs):
            if item.get("spacer"):
                rows.append("    { Stretch = 1 },")
                continue
            if item.get("time"):
                rows.append('    { Time = %s, Action = "Time" },' % toml_string(item["time"]))
                continue
            if item.get("battery"):
                rows.append('    { Battery = %s, Action = "Battery" },'
                            % toml_string(item["battery"]))
                continue
            painted = dict(item)
            painted["fill"] = self.palette.color(item["fill"], "surface")
            painted["fg"] = self.palette.color(item["fg"], "fg")
            painted["badge_fill"] = self.palette.color("sunken")
            painted["badge_fg"] = self.palette.color("fg")
            for field, fallback in (("bar", "accent"), ("track", "sunken"),
                                    ("sub_fg", "muted")):
                if item.get(field):
                    painted[field] = self.palette.color(item[field], fallback)
                elif field != "sub_fg":
                    painted[field] = self.palette.color(fallback)
                else:
                    painted[field] = self.palette.color("muted")
            scale = (scale_at or {}).get(index, 1.0)
            name = self.icons.store(
                build_svg(painted, width, radius, settings["font"], scale)
            )
            fields = ["Icon = %s" % toml_string(name or "search")]
            action = action_field(item.get("keys"))
            if action:
                fields.append(action)
            fields.append("IconWidth = %d" % int(width))
            fields.append("IconHeight = %d" % BAR_HEIGHT)
            rows.append("    { %s }," % ", ".join(fields))
        return emit(settings, rows)

    def render(self):
        with self.lock:
            self.reload_if_changed()
            specs = self.specs()
            actions = [None] + [item.get("daemon") for item in specs]
            changed = [
                i for i, item in enumerate(specs)
                if i >= len(self.prev_specs) or self.prev_specs[i] != item
            ]
            animate = bool(changed) and bool(self.prev_specs) \
                and self.config["settings"].get("animate", True) \
                and self.voice_state not in ("recording", "transcribing") \
                and not (self.claude is not None and self.claude.busy)
            self.prev_specs = specs
            self.generation += 1
            generation = self.generation
        if animate:
            threading.Thread(
                target=self._animate,
                args=(generation, specs, changed, actions), daemon=True
            ).start()
        else:
            self.queue(self.to_toml(specs), actions=actions)

    def _animate(self, generation, specs, changed, actions):
        """Pop the buttons that changed. Frames are whole repaints, so this
        costs three reloads regardless of how many buttons moved."""
        for scale in ANIMATION_FRAMES:
            if generation != self.generation:
                return
            self.queue(self.to_toml(specs, {i: scale for i in changed}),
                       generation, actions)
            time.sleep(ANIMATION_STEP)
        self.queue(self.to_toml(specs), generation, actions)

    def queue(self, text, generation=None, actions=None):
        with self.write_lock:
            if generation is not None and generation != self.generation:
                return
            if text == self.last_written:
                return
            self.pending = text
            self.pending_actions = actions
        self.flush()

    def touch_settled(self):
        return not self.fn_down and not self.touch_down and (
            time.monotonic() - self.touch_released_at > TOUCH_GRACE
        )

    def flush(self):
        """Write once no finger is down and Fn is not showing media controls."""
        with self.write_lock:
            if self.pending is None or not self.touch_settled():
                return
            text, self.pending = self.pending, None
            actions, self.pending_actions = self.pending_actions, None
            try:
                # In place, not an atomic rename: tiny-dfr watches this inode.
                with open(DFR_CONFIG, "w") as handle:
                    handle.write(text)
                self.last_written = text
                if actions is not None:
                    self.touch_actions = actions
            except OSError as exc:
                sys.stderr.write("omarchy-touchbar: cannot write %s: %s\n" % (DFR_CONFIG, exc))

    # -- commands ---------------------------------------------------------
    def command(self, line):
        parts = line.strip().split()
        if not parts:
            return "?"
        verb, args = parts[0], parts[1:]
        if verb == "page":
            target = args[0] if args else "next"
            if target == "next":
                base = self.page if self.page in PAGES else "auto"
                self.page = PAGES[(PAGES.index(base) + 1) % len(PAGES)]
            elif target in ("workspaces", "claude", "chatgpt"):
                self.page = "auto" if self.page == target else target
            elif target in PAGES:
                self.page = target
            self.render()
            return self.page
        if verb == "focus":
            try:
                slot = int(args[0]) - 1
            except (IndexError, ValueError):
                return "usage: focus N"
            if 0 <= slot < len(self.window_slots):
                # This Hyprland takes Lua expressions, not the old flat
                # "focuswindow address:0x..." dispatcher string.
                hypr('dispatch hl.dsp.focus({ window = "address:%s" })'
                     % self.window_slots[slot], as_json=False)
                return "ok"
            return "empty slot"
        if verb == "voice":
            action = args[0] if args else "toggle"
            if action == "clear":
                self.clear_dictation()
                return "cleared"
            self.toggle_voice()
            return self.voice_state
        if verb == "render":
            self.last_written = None
            self.prev_specs = []
            self.render()
            return "ok"
        if verb == "status":
            return json.dumps({"page": self.page, "windows": self.window_slots,
                               "voice": self.voice_state,
                               "voice_backend": self.voice_backend,
                               "chatgpt_thinking": self.chatgpt_thinking,
                               "chatgpt_usage": self.chatgpt_usage,
                               "chatgpt_stats": self.chatgpt_stats,
                               "fn_down": self.fn_down,
                               "last_touch": self.last_touch})
        return "unknown command"

    def active_window(self):
        return hypr("activewindow") or {}

    def handle_touch_action(self, action):
        """Dispatch daemon-owned controls directly. No synthetic keyboard
        event exists for these buttons, so workspace and mic cannot collide."""
        if not action:
            return
        kind, _, value = action.partition(":")
        if kind == "workspace":
            hypr('dispatch hl.dsp.focus({ workspace = "%s" })' % value,
                 as_json=False)
            if self.page == "workspaces":
                self.page = "auto"
            self.prev_specs = []  # workspace navigation should feel immediate
            self.render()
        elif kind == "page":
            if value == "next":
                base = self.page if self.page in PAGES else "auto"
                self.page = PAGES[(PAGES.index(base) + 1) % len(PAGES)]
            elif value in ("workspaces", "claude", "chatgpt"):
                self.page = "auto" if self.page == value else value
            self.prev_specs = []  # no decorative transition on navigation UI
            self.render()
        elif kind == "media":
            if value == "mute":
                self.media.toggle_mute()
            else:
                self.media.call({"playpause": "PlayPause", "next": "Next",
                                 "previous": "Previous"}.get(value, "PlayPause"))
                self.media.checked = 0.0
            self.render()
        elif kind in ("model", "effort") and value:
            self.run_slash("/%s %s" % (kind, value))
            self.page = "auto"
            self.prev_specs = []
            self.render()
        elif kind == "voice":
            self.clear_dictation() if value == "clear" else self.toggle_voice()
        elif kind == "focus" and value:
            hypr('dispatch hl.dsp.focus({ window = "address:%s" })' % value,
                 as_json=False)

    def run_slash(self, command):
        """Type a slash command into the focused Claude Code prompt.

        There is no IPC for this, so it goes through the keyboard. The prompt is
        cleared first - the same Ctrl+A/BackSpace pair clear_dictation uses -
        because a slash command only registers at the start of an empty line.
        """
        try:
            subprocess.run(["wtype", "-M", "ctrl", "-k", "a", "-m", "ctrl",
                            "-k", "BackSpace"], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, check=False)
            subprocess.run(["wtype", command, "-k", "Return"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           check=False)
        except OSError as exc:
            sys.stderr.write("omarchy-touchbar: cannot type %r: %s\n" % (command, exc))

    def send_key_state(self, key, state):
        hypr('dispatch hl.dsp.send_key_state({ key = "%s", state = "%s" })'
             % (key, state), as_json=False)

    def toggle_voice(self):
        active = self.active_window()
        address = active.get("address")
        backend = self.voice_backend_for(active)

        if self.voice_state == "review":
            self.voice_state = "idle"       # Add more appends at the cursor.

        if self.voice_state == "idle":
            self.voice_backend = backend
            self.voice_target = address
            self.review_until = 0.0
            if backend == "claude":
                # Claude Code native /voice: hold the default push-to-talk Space
                # across taps, then release it on the second tap.
                self.send_key_state("SPACE", "down")
                self.voice_state = "recording"
            elif backend == "chatgpt" and subprocess.run(
                    [CHATGPT_DICTATE], stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL).returncode == 0:
                self.voice_state = "recording"
            else:
                self.voice_backend = "voxtype"
                subprocess.Popen(["voxtype", "record", "start"],
                                 stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
                self.voice_state = "recording"
            self.render()
            return

        if self.voice_state == "recording":
            if self.voice_backend == "claude":
                self.send_key_state("SPACE", "up")
                self.voice_state = "transcribing"
                self.finish_native_later()
            elif self.voice_backend == "chatgpt" and subprocess.run(
                    [CHATGPT_DICTATE], stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL).returncode == 0:
                self.voice_state = "transcribing"
                self.finish_native_later()
            else:
                subprocess.Popen(["voxtype", "record", "stop"],
                                 stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
                self.voice_state = "transcribing"
            self.render()

    def finish_native_later(self):
        def finish():
            time.sleep(2.5)
            if self.voice_state == "transcribing":
                self.voice_state = "review"
                self.review_until = time.monotonic() + 15
                self.render()
        threading.Thread(target=finish, daemon=True).start()

    def clear_dictation(self):
        if self.voice_state != "review":
            return
        # Select and clear the input. This is intentionally routed through a
        # daemon command because tiny-dfr actions are chords, not sequences.
        subprocess.run(["wtype", "-M", "ctrl", "-k", "a", "-m", "ctrl",
                        "-k", "BackSpace"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
        self.voice_state = "idle"
        self.render()


# ------------------------------------------------------------------ preview --
def preview(bar, out="/tmp/omarchy-touchbar-preview.png"):
    """Rasterise the current layout the same way librsvg will on the panel."""
    settings = bar.config["settings"]
    width = cell_width(int(settings["slots"]))
    radius = int(settings["corner_radius"])
    specs = bar.specs()
    parts = []
    for index, item in enumerate([{"label": "esc", "fill": "sunken",
                                   "fg": "muted", "size": 20}] + specs):
        left = index * (width + BUTTON_SPACING)
        if item.get("spacer") or item.get("time") or item.get("battery"):
            continue
        painted = dict(item)
        painted["fill"] = bar.palette.color(item["fill"], "surface")
        painted["fg"] = bar.palette.color(item["fg"], "fg")
        body = build_svg(painted, width, radius, settings["font"])
        body = body.replace("<svg ", '<svg x="%.2f" ' % left, 1)
        parts.append(body)
    svg = (
        '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d">'
        '<defs><linearGradient id="g" x1="0" y1="0" x2="0" y2="1">'
        '<stop offset="0" stop-color="#ffffff" stop-opacity="0.10"/>'
        '<stop offset="1" stop-color="#ffffff" stop-opacity="0"/></linearGradient></defs>'
        '<rect width="%d" height="%d" fill="#000000"/>%s</svg>'
        % (BAR_WIDTH, BAR_HEIGHT, BAR_WIDTH, BAR_HEIGHT, "".join(parts))
    )
    source = out + ".svg"
    with open(source, "w") as handle:
        handle.write(svg)
    subprocess.run(["rsvg-convert", "-o", out, source], check=True)
    return out


# ------------------------------------------------------------------ daemon --
def serve(bar):
    if os.path.exists(SOCK_PATH):
        os.unlink(SOCK_PATH)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(SOCK_PATH)
    server.listen(8)
    while True:
        conn, _ = server.accept()
        try:
            data = conn.recv(4096).decode().strip()
            conn.sendall((bar.command(data) + "\n").encode())
        except Exception:                                   # noqa: BLE001
            pass
        finally:
            conn.close()


