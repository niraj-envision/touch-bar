def load_toml(path, fallback):
    try:
        with open(path, "rb") as handle:
            return tomllib.load(handle)
    except FileNotFoundError:
        return dict(fallback)
    except Exception as exc:                                # noqa: BLE001
        sys.stderr.write("omarchy-touchbar: %s: %s\n" % (path, exc))
        return dict(fallback)


def load_config():
    cfg = json.loads(json.dumps(DEFAULTS))
    user = load_toml(USER_CONFIG, {})
    cfg["settings"].update(user.get("settings", {}))
    cfg["icons"] = user.get("icons", {})
    cfg["profiles"] = user.get("profiles", [])
    return cfg


class Palette:
    """Named roles resolved against the current Omarchy theme."""

    def __init__(self, theme):
        self.theme = dict(FALLBACK_THEME)
        self.theme.update({k: v for k, v in theme.items() if isinstance(v, str)})
        get = self.theme.get
        self.roles = {
            "surface": get("lighter_background"),
            "sunken": get("darker_background"),
            "raised": get("selection"),
            "accent": get("accent"),
            "on_accent": get("dark_background"),
            "fg": get("foreground"),
            "muted": get("muted"),
        }

    def color(self, name, default="fg"):
        if not name:
            name = default
        if isinstance(name, str) and name.startswith("#"):
            return name
        return self.roles.get(name) or self.theme.get(name) or self.roles["fg"]


