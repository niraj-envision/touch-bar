def compact(n):
    """472823 -> '473k'. The Touch Bar has no room for thousands separators."""
    n = int(n or 0)
    if n >= 1_000_000_000:
        return ("%.2fB" % (n / 1_000_000_000)).replace(".00B", "B")
    if n >= 1_000_000:
        return ("%.1fM" % (n / 1_000_000)).replace(".0M", "M")
    if n >= 1000:
        return "%dk" % round(n / 1000)
    return str(n)


def stamp_to_epoch(stamp):
    if isinstance(stamp, (int, float)):
        return float(stamp)
    try:
        return calendar.timegm(time.strptime((stamp or "")[:19], "%Y-%m-%dT%H:%M:%S"))
    except (ValueError, TypeError):
        return 0.0


def plan_tier():
    """'default_claude_max_20x' -> 'max 20x'. Read from the credentials file,
    which is the only local record of the subscription; no token is touched."""
    try:
