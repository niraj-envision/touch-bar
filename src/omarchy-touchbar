    "activewindow", "activewindowv2", "workspace", "workspacev2", "focusedmon",
    "openwindow", "closewindow", "movewindow", "createworkspace",
    "destroyworkspace", "urgent", "changefloatingmode", "configreloaded",
)


def watch_hyprland(bar):
    path = os.path.join(HYPR_DIR, ".socket2.sock")
    pending = threading.Event()

    def painter():
        while True:
            pending.wait()
            time.sleep(0.04)          # coalesce bursts of events
            pending.clear()
            active = bar.active_window()
            if bar.voice_state == "review" and bar.voice_target \
                    and active.get("address") != bar.voice_target:
                bar.voice_state = "idle"
                bar.review_until = 0.0
            # Picking a workspace from the picker page is the end of that errand.
            if bar.page == "workspaces":
                bar.page = "auto"
            bar.render()

    threading.Thread(target=painter, daemon=True).start()

    while True:
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.connect(path)
            buffer = ""
            while True:
                chunk = sock.recv(8192)
                if not chunk:
                    break
                buffer += chunk.decode(errors="replace")
                while "\n" in buffer:
                    line, buffer = buffer.split("\n", 1)
                    if line.split(">>", 1)[0] in INTERESTING:
                        pending.set()
        except Exception:                                   # noqa: BLE001
            pass
        time.sleep(1)                 # Hyprland restarted; reconnect


def find_input_device(name):
    """Return the event node for an exact input-device name."""
    block = []
    for line in open("/proc/bus/input/devices"):
        if line.strip():
            block.append(line)
            continue
        text = "".join(block)
        block = []
        if 'N: Name="%s"' % name in text:
            match = re.search(r"Handlers=.*?(event\d+)", text)
            if match:
                return "/dev/input/" + match.group(1)
    return None


def find_digitizer():
    """The Touch Bar's own touch surface, so we can tell when a finger is down."""
    return find_input_device(DIGITIZER_NAME)


def watch_fn(bar):
    """Keep daemon repaints from dismissing tiny-dfr's Fn media layer.

    tiny-dfr handles the physical Fn key itself. We only mirror its held state:
    config reloads pause on key-down and the newest queued frame lands after
    key-up. This preserves animations without making media buttons untappable.
    """
    path = find_input_device(KEYBOARD_NAME)
    if not path:
        sys.stderr.write("omarchy-touchbar: no internal keyboard; Fn is ungated\n")
        return
    while True:
        try:
            with open(path, "rb", buffering=0) as handle:
                while True:
                    data = handle.read(INPUT_EVENT.size)
                    if not data or len(data) < INPUT_EVENT.size:
                        break
                    _, _, etype, code, value = INPUT_EVENT.unpack(data)
                    if etype != EV_KEY or code != KEY_FN:
                        continue
                    if value == 1:
                        bar.fn_down = True
                    elif value == 0:
                        bar.fn_down = False
                        bar.touch_released_at = time.monotonic()
                        bar.flush()
        except OSError:
            bar.fn_down = False
        time.sleep(2)


def watch_touches(bar):
    path = find_digitizer()
    if not path:
        sys.stderr.write("omarchy-touchbar: no Touch Bar digitizer; repaints are ungated\n")
        return
    raw_x = None
    while True:
        try:
            with open(path, "rb", buffering=0) as handle:
                while True:
                    data = handle.read(INPUT_EVENT.size)
                    if not data or len(data) < INPUT_EVENT.size:
                        break
                    _, _, etype, code, value = INPUT_EVENT.unpack(data)
                    if etype == EV_ABS and code in (ABS_X, ABS_MT_POSITION_X):
                        raw_x = value
                    if etype == EV_KEY and code == BTN_TOUCH:
                        if value:
                            bar.touch_down = True
                        else:
                            bar.touch_down = False
                            bar.touch_released_at = time.monotonic()
                            if raw_x is not None:
                                cells = int(bar.config["settings"]["slots"]) + 1
                                width = cell_width(cells - 1)
                                pixel_x = max(0.0, min(BAR_WIDTH - 0.01,
                                    raw_x / 32767.0 * BAR_WIDTH))
                                stride = width + BUTTON_SPACING
                                index = int(pixel_x / stride)
                                inside = pixel_x - index * stride
                                if inside <= width and 0 <= index < len(bar.touch_actions):
                                    action = bar.touch_actions[index]
                                    bar.last_touch = {
                                        "raw_x": raw_x, "slot": index,
                                        "action": action,
                                    }
                                    if action:
                                        sys.stderr.write(
                                            "omarchy-touchbar: raw touch slot=%d action=%s\n"
                                            % (index, action))
                                    try:
                                        bar.handle_touch_action(action)
                                    except Exception as exc:  # keep touch thread alive
                                        sys.stderr.write(
                                            "omarchy-touchbar: touch action failed: %s\n" % exc)
        except OSError:
            pass
        time.sleep(2)


def keep_awake(bar):
    """Hold the Touch Bar lit while something is actually happening.

    tiny-dfr dims the panel 30 s after the last libinput event and blacks it out
    at 60 s (BRIGHTNESS_DIM_TIMEOUT / BRIGHTNESS_OFF_TIMEOUT). Dictating a long
    message or watching Claude work involves no input at all, so the bar goes
    dark exactly when you are looking at it. tiny-dfr only writes the backlight
    when its own computed value changes, so re-asserting full brightness here
    sticks between its transitions.

    Needs write access to the backlight attribute; without the udev rule from
    install.sh this quietly does nothing.
    """
    try:
        with open(os.path.join(TOUCHBAR_BACKLIGHT, "max_brightness")) as handle:
            full = str(int(handle.read().strip()))
    except (OSError, ValueError):
        return
    path = os.path.join(TOUCHBAR_BACKLIGHT, "brightness")
    complained = False
    while True:
        busy = bar.voice_state in ("recording", "transcribing") \
            or (bar.claude is not None and bar.claude.busy)
        if busy:
            try:
                with open(path, "w") as handle:
                    handle.write(full)
            except OSError as exc:
                if not complained:
                    complained = True
                    sys.stderr.write(
                        "omarchy-touchbar: cannot hold the backlight on (%s); "
                        "re-run install.sh to add the udev rule\n" % exc)
        time.sleep(2)


def drain(bar):
    """Write out layouts that were held back while the bar was being touched."""
    while True:
        time.sleep(0.03)
        bar.flush()


def watch_voxtype(bar):
    """Mirror Omarchy's real dictation states into the Touch Bar."""
    previous = "idle"
    while True:
        try:
            with open(VOXTYPE_STATE) as handle:
                state = handle.read().strip() or "idle"
        except OSError:
            state = "idle"
        if state != previous:
            if state in ("recording", "transcribing"):
                if bar.voice_backend in (None, "voxtype"):
                    bar.voice_backend = "voxtype"
                    bar.voice_state = state
                    if not bar.voice_target:
                        bar.voice_target = bar.active_window().get("address")
                    bar.render()
            elif previous == "transcribing" and bar.voice_backend == "voxtype":
                bar.voice_state = "review"
                bar.review_until = time.monotonic() + 15
                bar.render()
            elif previous == "recording" and bar.voice_backend == "voxtype":
                bar.voice_state = "idle"
                bar.render()
            previous = state
        time.sleep(0.08)


CODEX_SESSION_CACHE = {}


def codex_session_summary(path):
    """Cache slow-changing, non-message session fields for five seconds."""
    cached = CODEX_SESSION_CACHE.get(path)
    if cached and time.monotonic() - cached[0] < 5:
        return cached[1]
    summary = {"model": "", "effort": "", "turns": 0,
               "active_started": 0.0}
    try:
        with open(path, errors="replace") as handle:
            for line in handle:
                try:
                    payload = json.loads(line).get("payload") or {}
                except json.JSONDecodeError:
                    continue
                event_type = payload.get("type")
                if event_type == "task_started":
                    summary["turns"] += 1
                    summary["active_started"] = stamp_to_epoch(
                        payload.get("started_at"))
                elif event_type in ("task_complete", "turn_aborted"):
                    summary["active_started"] = 0.0
                elif event_type == "thread_settings_applied":
                    settings = payload.get("thread_settings") or {}
                    summary["model"] = settings.get("model") or summary["model"]
                    summary["effort"] = (settings.get("reasoning_effort") or
                                         summary["effort"])
    except OSError:
        pass
    CODEX_SESSION_CACHE[path] = (time.monotonic(), summary)
    return summary


def latest_codex_state():
    """Read numeric/state metadata from recent desktop rollouts.

    Message text and tool arguments are deliberately ignored. The result feeds
    the same kind of live status strip Claude Code gets: work state, context,
    output, turns, tools, model, elapsed time, and real rate-limit gauges.
    """
    paths = glob.glob(os.path.join(HOME, ".codex", "sessions", "**", "*.jsonl"),
                      recursive=True)
    if not paths:
        return {}
    now = time.time()
    paths = sorted(paths, key=lambda p: os.path.getmtime(p), reverse=True)[:16]
    newest = None
    active_tasks = 0
    rate = {"usage": None, "secondary_usage": None, "mtime": -1}
    for path in paths:
        mtime = os.path.getmtime(path)
        if now - mtime > 1800:
            continue
        try:
            with open(path, "rb") as handle:
                # Ignore guardian/reviewer/subagent rollouts. Their tiny,
                # short-lived model names made the desktop panel jump away
                # from the user's actual ChatGPT/Codex task.
                prefix = handle.read(32768).decode(errors="replace")
                metadata = {}
                for line in prefix.splitlines():
                    try:
                        candidate = json.loads(line).get("payload") or {}
                    except json.JSONDecodeError:
                        continue
                    if candidate.get("session_id"):
                        metadata = candidate
                        break
                source = metadata.get("source")
                if metadata.get("parent_thread_id") or \
                        metadata.get("thread_source") or isinstance(source, dict):
                    continue
                handle.seek(0, os.SEEK_END)
                end = handle.tell()
                handle.seek(max(0, end - 262144))
                raw = handle.read().decode(errors="replace")
        except OSError:
            continue
        static = codex_session_summary(path)
        detail = {
            "model": static["model"], "effort": static["effort"],
            "context": 0, "context_limit": 0,
            "output": 0, "turns": static["turns"], "tools": 0, "tool": "",
            "active_for": "-",
        }
        events = []
        started_at = static["active_started"]
        boundary_line = -1
        line_number = -1
        file_rate = {"usage": None, "secondary_usage": None}
        for line_number, line in enumerate(raw.splitlines()):
            try:
                item = json.loads(line)
            except json.JSONDecodeError:
                continue
            payload = item.get("payload") or {}
            event_type = payload.get("type")
            if event_type in ("task_started", "task_complete", "turn_aborted"):
                events.append(event_type)
                boundary_line = line_number
                if event_type == "task_started":
                    started_at = stamp_to_epoch(payload.get("started_at"))
                else:
                    started_at = 0.0
            if event_type == "thread_settings_applied":
                settings = payload.get("thread_settings") or {}
                detail["model"] = settings.get("model") or detail["model"]
                detail["effort"] = (settings.get("reasoning_effort") or
                                    detail["effort"])
            if event_type in ("function_call", "custom_tool_call"):
                detail["tools"] += 1
                detail["tool"] = (payload.get("name") or "tool").split("__")[-1]
            if event_type == "token_count":
                info = payload.get("info") or {}
                last = info.get("last_token_usage") or {}
                total = info.get("total_token_usage") or {}
                detail["context"] = int(last.get("total_tokens") or 0)
                detail["context_limit"] = int(info.get("model_context_window") or 0)
                detail["output"] = int(total.get("output_tokens") or 0)
                limits = payload.get("rate_limits") or {}
                primary = limits.get("primary") or {}
                secondary = limits.get("secondary") or {}
                if primary.get("used_percent") is not None:
                    file_rate["usage"] = int(round(primary["used_percent"]))
                if secondary.get("used_percent") is not None:
                    file_rate["secondary_usage"] = int(
                        round(secondary["used_percent"]))
        file_active = bool(events) and events[-1] == "task_started"
        # A single tool-heavy turn can push task_started outside the 256 KiB
        # tail. Fresh reasoning/tool events after the last boundary still mean
        # the task is live; task_complete itself remains the clean stop signal.
        if now - mtime < 15:
            file_active = file_active or not events \
                or (line_number - boundary_line > 3)
        if file_active:
            active_tasks += 1
            if started_at:
                seconds = max(0, int(now - started_at))
                detail["active_for"] = ("%dm" % (seconds // 60)
                                        if seconds >= 60 else "%ds" % seconds)
        detail["thinking"] = file_active
        if newest is None:
            newest = detail
        if any(value is not None for value in file_rate.values()) \
                and mtime > rate["mtime"]:
            rate.update(file_rate, mtime=mtime)

    newest = newest or {}
    newest["thinking"] = active_tasks > 0
    newest["active_tasks"] = active_tasks
    newest["usage"] = rate["usage"]
    newest["secondary_usage"] = rate["secondary_usage"]
    return newest


def watch_chatgpt(bar):
    """Animate from actual Codex task events and show real telemetry."""
    previous = None
    while True:
        current = latest_codex_state()
        if current != previous:
            bar.chatgpt_stats = current
            bar.chatgpt_thinking = bool(current.get("thinking"))
            bar.chatgpt_usage = current.get("usage")
            previous = current
            active = bar.active_window()
            if re.search(r"^(chatgpt|ChatGPT)$", active.get("class", "")):
                bar.render()
        time.sleep(0.45)


def animate_live_states(bar):
    """Four-frame animation only while recording/transcribing or thinking."""
    while True:
        active = bar.active_window()
        chatgpt_visible = re.search(r"^(chatgpt|ChatGPT)$", active.get("class", ""))
        bar.media.refresh()
        moving = bar.voice_state in ("recording", "transcribing") \
            or (chatgpt_visible and bar.chatgpt_thinking) \
            or bar.media.playing
        if moving:
            bar.voice_phase += 1
            bar.chatgpt_phase += 1
            bar.media_phase += 1
            bar.render()
            time.sleep(0.24)
        else:
            if bar.voice_state == "review" and bar.review_until \
                    and time.monotonic() > bar.review_until:
                bar.voice_state = "idle"
                bar.review_until = 0.0
                bar.render()
            time.sleep(0.35)


def watch_claude(bar):
    """Drive the spinner while Claude works, and repaint when the tally moves.

    Claude Code appends to its transcript as it goes, so polling that file is
    enough - no hooks and no changes to ~/.claude/settings.json.
    """
    last = None
    while True:
        session = bar.claude_for(bar.active_window())
        if session is None:
            last = None
            time.sleep(0.5)
            continue
        settings = bar.config["settings"]
        if session.busy and settings.get("animate", True):
            # Every frame is a whole config reload (~13 ms of tiny-dfr's CPU),
            # so pace it: four frames at this interval still reads as a spinner.
            bar.claude_phase += 1
            bar.render()
            time.sleep(float(settings.get("claude_spinner", 0.32)))
            continue
        digest = (session.state, session.context, session.output,
                  session.turns, session.permission)
        if digest != last:
            last = digest
            bar.render()
        time.sleep(0.4)


def restore_static():
    """Leave a plain function row behind when the daemon stops."""
    rows = ['    { Text = "F%d", Action = "F%d" },' % (n, n) for n in range(1, 13)]
    rows += ["    { Stretch = 1 },"] * (int(DEFAULTS["settings"]["slots"]) - len(rows))
    settings = dict(DEFAULTS["settings"])
    try:
        with open(DFR_CONFIG, "w") as handle:
            handle.write(emit(settings, rows).replace(
                "ShowButtonOutlines = false", "ShowButtonOutlines = true"))
    except OSError:
        pass


def run_daemon():
    bar = TouchBar(clear_cache=True)

    def bye(*_):
        restore_static()
        sys.exit(0)

    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)
    threading.Thread(target=watch_fn, args=(bar,), daemon=True).start()
    threading.Thread(target=watch_touches, args=(bar,), daemon=True).start()
    threading.Thread(target=drain, args=(bar,), daemon=True).start()
    threading.Thread(target=watch_voxtype, args=(bar,), daemon=True).start()
    threading.Thread(target=watch_chatgpt, args=(bar,), daemon=True).start()
    threading.Thread(target=animate_live_states, args=(bar,), daemon=True).start()
    threading.Thread(target=watch_claude, args=(bar,), daemon=True).start()
    threading.Thread(target=keep_awake, args=(bar,), daemon=True).start()
    threading.Thread(target=serve, args=(bar,), daemon=True).start()
    bar.render()
    watch_hyprland(bar)


def send(line):
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(3.0)
        sock.connect(SOCK_PATH)
        sock.sendall(line.encode())
        return sock.recv(4096).decode().strip()
    except Exception:                                       # noqa: BLE001
        return None


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if args[0] == "daemon":
        run_daemon()
        return 0
    if args[0] == "preview":
        print(preview(TouchBar()))
        return 0
    if args[0] == "render" and not send("render"):
        TouchBar().render()
        return 0
    reply = send(" ".join(args))
    if reply is None:
        sys.stderr.write("omarchy-touchbar: daemon is not running\n")
        return 1
    if args[0] == "status":
        print(reply)
    return 0


if __name__ == "__main__":
    sys.exit(main())
