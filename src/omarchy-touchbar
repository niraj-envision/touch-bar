# tiny-dfr Action; the daemon fires key chords itself through wtype, a virtual
# keyboard, which Hyprland runs through its binds exactly like a real one (so
# SUPER+Return still opens a terminal).
WTYPE_MODS = {"LeftCtrl": "ctrl", "LeftShift": "shift",
              "LeftAlt": "alt", "LeftMeta": "logo"}
WTYPE_KEYS = {
    "Enter": "Return", "Esc": "Escape", "Space": "space",
    "Backspace": "BackSpace", "PageUp": "Page_Up", "PageDown": "Page_Down",
    "Dot": "period", "Comma": "comma", "Slash": "slash", "Minus": "minus",
    "Equal": "equal", "Grave": "grave", "Backslash": "backslash",
    "Semicolon": "semicolon", "Apostrophe": "apostrophe",
    "LeftBrace": "bracketleft", "RightBrace": "bracketright",
    "PlayPause": "XF86AudioPlay", "NextSong": "XF86AudioNext",
    "PreviousSong": "XF86AudioPrev", "MicMute": "XF86AudioMicMute",
    "Mute": "XF86AudioMute", "VolumeUp": "XF86AudioRaiseVolume",
    "VolumeDown": "XF86AudioLowerVolume",
}


def wtype_args(keys):
    """A parsed chord -> wtype arguments, modifiers held around the key."""
    names = parse_chord(keys) if isinstance(keys, str) else list(keys or [])
    mods = [WTYPE_MODS[n] for n in names if n in WTYPE_MODS]
    rest = [n for n in names if n not in WTYPE_MODS]
    if not rest:
        return None
    key = rest[-1]
    if key in WTYPE_KEYS:
        key = WTYPE_KEYS[key]
    elif key.startswith("Num") and len(key) == 4:
        key = key[3]
    elif len(key) == 1:
        key = key.lower()
    args = []
    for mod in mods:
        args += ["-M", mod]
    args += ["-k", key]
    for mod in reversed(mods):
        args += ["-m", mod]
    return args


