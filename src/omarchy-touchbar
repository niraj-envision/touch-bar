def run_quiet(args):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


class MediaState:
    """Whatever is playing, from MPRIS on the session bus.

    playerctl is not installed here, so this talks to the bus directly through
    busctl - the same interface playerctl would use.
    """

    def __init__(self):
        self.player = ""
        self.status = "Stopped"
        self.title = ""
        self.muted = False
        self.checked = 0.0

    def refresh(self, interval=1.5):
        now = time.monotonic()
        if now - self.checked < interval:
            return
        self.checked = now
        names = [n for n in run_quiet(["busctl", "--user", "list", "--no-pager"]).split()
                 if n.startswith("org.mpris.MediaPlayer2.")]
        chosen, status = "", "Stopped"
        for name in names:
            state = self._property(name, "PlaybackStatus")
            if state == "Playing":
                chosen, status = name, state
                break
            if state == "Paused" and not chosen:
                chosen, status = name, state
        self.player, self.status = chosen, status
        volume = run_quiet(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
        self.muted = "MUTED" in volume

    def _property(self, name, prop):
        out = run_quiet(["busctl", "--user", "get-property", name, MPRIS_PATH,
                         MPRIS_PLAYER, prop])
        parts = out.strip().split('"')
        return parts[1] if len(parts) > 1 else ""

    @property
    def active(self):
        return bool(self.player) and self.status in ("Playing", "Paused")

    @property
    def playing(self):
        return self.status == "Playing"

    def call(self, method):
        if self.player:
            run_quiet(["busctl", "--user", "call", self.player, MPRIS_PATH,
                       MPRIS_PLAYER, method])

    def toggle_mute(self):
        run_quiet(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"])
        self.checked = 0.0


def until(iso):
    """'2026-09-06T15:00:00+00:00' -> '6d'. Empty when it has already passed."""
    target = stamp_to_epoch(iso)
    if not target:
        return ""
    left = target - time.time()
    if left <= 0:
        return ""
    if left >= 86400:
        return "%dd" % round(left / 86400)
    if left >= 3600:
        return "%dh" % round(left / 3600)
    return "%dm" % max(1, round(left / 60))


class UsageLimits:
    """Claude Code's own cached rate-limit read-out.

    This is what `/usage` renders. Claude Code refreshes it into ~/.claude.json
    under `cachedUsageUtilization`, so the real session and weekly headroom is
    available without an API call and without touching the OAuth token.

    `limits` is a list of {kind, percent, severity, resets_at, scope}; kinds are
    `session`, `weekly_all` and `weekly_scoped` (scoped to a model, e.g. Fable).
    `percent` is the share *used*.
    """

    def __init__(self):
        self.stamp = None
        self.entries = {}
        self.fetched = 0.0
        self.checked = 0.0

    def refresh(self, interval=10.0):
        now = time.monotonic()
        if now - self.checked < interval:
            return
        self.checked = now
        try:
            info = os.stat(CLAUDE_CONFIG)
        except OSError:
            return
        stamp = (info.st_mtime, info.st_size)
        if stamp == self.stamp:
            return
        self.stamp = stamp
        try:
            with open(CLAUDE_CONFIG) as handle:
                cached = (json.load(handle) or {}).get("cachedUsageUtilization") or {}
        except (OSError, ValueError):
            return
        self.fetched = (cached.get("fetchedAtMs") or 0) / 1000.0
        entries = {}
        for item in ((cached.get("utilization") or {}).get("limits") or []):
            if not isinstance(item, dict):
                continue
            kind = item.get("kind") or ""
            model = ((item.get("scope") or {}).get("model") or {}).get("display_name")
            if kind == "weekly_scoped":
                kind = "weekly_" + (model or "model").lower().replace(" ", "")
            entries[kind] = {
                "percent": item.get("percent"),
                "resets_at": item.get("resets_at"),
                "severity": item.get("severity") or "normal",
                "model": model or "",
            }
        self.entries = entries

    def get(self, kind):
        return self.entries.get(kind)

    def scoped_kind(self):
        """The model-scoped weekly bucket, whatever model it is scoped to."""
        for kind in self.entries:
            if kind.startswith("weekly_") and kind != "weekly_all":
                return kind
        return None

    def stale(self):
        return self.fetched and (time.time() - self.fetched) > 3600


class ClaudeTotals:
    """Running token totals across every Claude Code transcript on this machine.

    The whole corpus is a few megabytes, so the first pass is cheap and every
    pass after that reads only what was appended.
    """

    WINDOW = 7 * 86400

    def __init__(self):
        self.offsets = {}
        self.total = 0
        self.recent = []          # (epoch, tokens) inside the rolling window
        self.checked = 0.0

    def refresh(self, interval=15.0, force=False):
        now = time.monotonic()
        if not force and now - self.checked < interval:
            return
        self.checked = now
        for path in glob.glob(os.path.join(HOME, ".claude", "projects", "*", "*.jsonl")):
            try:
                size = os.path.getsize(path)
            except OSError:
                continue
            start = self.offsets.get(path, 0)
            if size < start:                      # truncated or replaced
                start = 0
            if size == start:
                continue
            try:
                with open(path, "r", errors="replace") as handle:
                    handle.seek(start)
                    chunk = handle.read()
                    self.offsets[path] = handle.tell()
            except OSError:
                continue
            for line in chunk.splitlines():
                if '"usage"' in line:
                    self._absorb(line)
        cutoff = time.time() - self.WINDOW
        self.recent = [(t, n) for t, n in self.recent if t >= cutoff]

    def _absorb(self, line):
        try:
            record = json.loads(line)
        except ValueError:
            return
        usage = (record.get("message") or {}).get("usage") or {}
        if not usage:
            return
        tokens = (usage.get("input_tokens", 0)
                  + usage.get("cache_read_input_tokens", 0)
                  + usage.get("cache_creation_input_tokens", 0)
                  + usage.get("output_tokens", 0))
        if not tokens:
            return
        self.total += tokens
        self.recent.append((stamp_to_epoch(record.get("timestamp")), tokens))

    def week(self):
        cutoff = time.time() - self.WINDOW
        return sum(n for t, n in self.recent if t >= cutoff)


def descendant_named(pid, name, depth=0):
    """Find `claude` running under a terminal window's process."""
    if depth > 6:
        return None
    try:
        with open("/proc/%d/comm" % pid) as handle:
            if handle.read().strip() == name:
                return pid
        with open("/proc/%d/task/%d/children" % (pid, pid)) as handle:
            kids = [int(x) for x in handle.read().split()]
    except (OSError, ValueError):
        return None
    for kid in kids:
        found = descendant_named(kid, name, depth + 1)
        if found:
            return found
    return None


class ClaudeSession:
    """Reads a Claude Code transcript incrementally and keeps a running tally.

    Everything here comes out of ~/.claude/projects/<slug>/<session>.jsonl, which
    Claude Code appends to as it goes - no hooks, no settings changes, and it
    works for every session automatically.
    """

    IDLE, THINKING, TOOL = "idle", "thinking", "tool"

    def __init__(self, path):
        self.path = path
        self.offset = 0
        self.reset()

    def reset(self):
        self.title = ""
        self.permission = ""
        self.context = 0
        self.output = 0
        self.cache_read = 0
        self.turns = 0
        self.tools = {}
        self.first_ts = self.last_ts = ""
        self.state = self.IDLE
        self.tool = ""
        self.model = ""
        self.effort = ""
        self.reported = ""
        self.name = ""

    def refresh(self):
        try:
            size = os.path.getsize(self.path)
        except OSError:
            return False
        if size < self.offset:              # rotated or replaced
            self.offset = 0
            self.reset()
        elif size == self.offset:
            return False
        try:
            with open(self.path, "r", errors="replace") as handle:
                handle.seek(self.offset)
                chunk = handle.read()
                self.offset = handle.tell()
        except OSError:
            return False
        for line in chunk.splitlines():
            if line.strip():
                self._absorb(line)
        return True

    def _absorb(self, line):
        try:
            record = json.loads(line)
        except ValueError:
            return
        kind = record.get("type")
        if kind == "ai-title":
            self.title = record.get("aiTitle", "") or self.title
            return
        if kind == "permission-mode":
            self.permission = record.get("permissionMode", "") or self.permission
            return
        if kind not in ("user", "assistant") or record.get("isSidechain"):
            return
        stamp = record.get("timestamp")
        if stamp:
            self.first_ts = self.first_ts or stamp
            self.last_ts = stamp
        message = record.get("message") or {}
        self.model = message.get("model") or self.model
        self.effort = record.get("effort") or self.effort
        usage = message.get("usage") or {}
        if usage:
            self.output += usage.get("output_tokens", 0)
            self.cache_read += usage.get("cache_read_input_tokens", 0)
            self.context = (usage.get("input_tokens", 0)
                            + usage.get("cache_read_input_tokens", 0)
                            + usage.get("cache_creation_input_tokens", 0))
        blocks = message.get("content")
        blocks = blocks if isinstance(blocks, list) else []
        kinds = {b.get("type") for b in blocks if isinstance(b, dict)}
        if kind == "user":
            # A tool result is Claude's own turn continuing, not a new prompt.
            if "tool_result" not in kinds:
                self.turns += 1
            self.state, self.tool = self.THINKING, ""
            return
        pending = [b for b in blocks if isinstance(b, dict) and b.get("type") == "tool_use"]
        for block in pending:
            name = block.get("name", "?")
            self.tools[name] = self.tools.get(name, 0) + 1
        if pending:
            # Written before the tool runs, so the last one is the running one.
            self.state, self.tool = self.TOOL, pending[-1].get("name", "")
        else:
            self.state, self.tool = self.IDLE, ""

    @property
    def busy(self):
        if self.reported:
            return self.reported == "busy"
        return self.state != self.IDLE

    def elapsed(self):
        try:
            start = time.mktime(time.strptime(self.first_ts[:19], "%Y-%m-%dT%H:%M:%S"))
            end = time.mktime(time.strptime(self.last_ts[:19], "%Y-%m-%dT%H:%M:%S"))
        except (ValueError, TypeError):
            return ""
        minutes = max(0, int((end - start) // 60))
        return "%dh%02d" % (minutes // 60, minutes % 60) if minutes >= 60 else "%dm" % minutes


def transcript_for(cwd):
    slug = cwd.replace("/", "-")
    found = glob.glob(os.path.join(HOME, ".claude", "projects", slug, "*.jsonl"))
    return max(found, key=os.path.getmtime) if found else None


# ------------------------------------------------------------- hyprland ipc --
def hypr(command, as_json=True):
    path = os.path.join(HYPR_DIR, ".socket.sock")
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(2.0)
        sock.connect(path)
        sock.sendall((("j/" if as_json else "/") + command).encode())
        chunks = []
        while True:
            chunk = sock.recv(65536)
            if not chunk:
                break
            chunks.append(chunk)
        sock.close()
        raw = b"".join(chunks)
        return json.loads(raw) if as_json else raw.decode()
    except Exception:                                       # noqa: BLE001
        return None


# ----------------------------------------------------------- button drawing --
def cell_width(slots):
    cells = slots + 1                       # tiny-dfr prepends its own esc key
    return (BAR_WIDTH - BUTTON_SPACING * (cells - 1)) / cells


def build_svg(spec, width, radius, font, scale=1.0):
    """One button, drawn edge to edge so we own every pixel of it."""
    label = html.escape(spec.get("label", ""))
    size = spec.get("size", 26)
    caption = html.escape(str(spec.get("sub") or ""))
    gauge = spec.get("gauge")
    # Use essentially all 60 physical pixels. The old 48px pills looked like a
    # narrow toolbar floating inside the Touch Bar instead of owning it.
    pill_w, pill_h = width - 4, 58
    centre = "%.2f %.2f" % (width / 2, BAR_HEIGHT / 2)
    transform = (
        ' transform="translate(%s) scale(%.3f) translate(-%s)"' % (centre, scale, centre)
        if scale != 1.0
        else ""
    )
    gloss = ""
    if spec.get("gloss", True):
        gloss = (
            '<rect x="2" y="1" width="%.2f" height="%.2f" rx="%d" fill="url(#g)"/>'
            % (pill_w, pill_h / 2, radius)
        )
    badge = ""
    if spec.get("badge"):
        badge = (
            '<circle cx="%.2f" cy="13" r="9" fill="%s"/>'
            '<text x="%.2f" y="16.5" font-family="%s" font-size="11" '
            'font-weight="bold" fill="%s" text-anchor="middle">%s</text>'
            % (width - 15, spec.get("badge_fill", "#161616"), width - 15,
               font, spec.get("badge_fg", "#d4be98"),
               html.escape(str(spec["badge"])))
        )
    glow = ""
    shadow = ""
    if spec.get("glow"):
        glow = (
            '<filter id="halo" x="-30%" y="-60%" width="160%" height="220%">'
            '<feGaussianBlur stdDeviation="3" result="blur"/>'
            '<feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/>'
            '</feMerge></filter>'
        )
        shadow = ' filter="url(#halo)"'
    fg = spec.get("fg", "#d4be98")

    def text(y, body, px, colour):
        if not body:
            return ""
        return ('<text x="%.2f" y="%.2f" font-family="%s" font-size="%d" '
                'font-weight="bold" fill="%s" text-anchor="middle">%s</text>'
                % (width / 2, y, font, px, colour, body))

    bars = spec.get("bars")
    if bars:
        count = len(bars)
        bar_w, gap = 7.0, 5.0
        span = count * bar_w + (count - 1) * gap
        left = (width - span) / 2.0
        tallest = 34.0
        body = ""
        for index, height in enumerate(bars):
            tall = max(5.0, tallest * float(height))
            body += ('<rect x="%.2f" y="%.2f" width="%.2f" height="%.2f" rx="3" '
                     'fill="%s"/>'
                     % (left + index * (bar_w + gap),
                        BAR_HEIGHT / 2 - tall / 2, bar_w, tall,
                        spec.get("fg", "#d4be98")))
    elif gauge is not None:
        pad, track_y, track_h = 16.0, 42.0, 8.0
        track_w = width - pad * 2
        filled = max(track_h, track_w * min(max(float(gauge), 0.0), 1.0))
        body = (
            text(26, label, size, fg)
            + text(38, caption, spec.get("sub_size", 13), spec.get("sub_fg", fg))
            + '<rect x="%.2f" y="%.2f" width="%.2f" height="%.2f" rx="%.2f" fill="%s"/>'
              % (pad, track_y, track_w, track_h, track_h / 2, spec.get("track", "#161616"))
            + '<rect x="%.2f" y="%.2f" width="%.2f" height="%.2f" rx="%.2f" fill="%s"/>'
              % (pad, track_y, filled, track_h, track_h / 2, spec.get("bar", fg))
        )
    elif caption:
        body = (text(29, label, size, fg)
                + text(47, caption, spec.get("sub_size", 14), spec.get("sub_fg", fg)))
    else:
        body = text(BAR_HEIGHT / 2 + size * 0.36, label, size, fg)

    return (
        '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" '
        'viewBox="0 0 %d %d">'
        '<defs><linearGradient id="g" x1="0" y1="0" x2="0" y2="1">'
        '<stop offset="0" stop-color="#ffffff" stop-opacity="0.10"/>'
        '<stop offset="1" stop-color="#ffffff" stop-opacity="0"/>'
        "</linearGradient>%s</defs>"
        '<g%s%s><rect x="2" y="1" width="%.2f" height="%.2f" rx="%d" fill="%s"/>%s'
        "%s%s</g></svg>"
        % (
            int(width), BAR_HEIGHT, int(width), BAR_HEIGHT,
            glow, transform, shadow, pill_w, pill_h, radius,
            spec.get("fill", "#3c3836"), gloss, body, badge,
        )
    )


class IconCache:
    """SVGs are content-addressed, so identical buttons reuse one file."""

    def __init__(self, clear=False):
        self.known = set()
        if clear:
            try:
                shutil.rmtree(GEN_DIR)
            except OSError:
                pass
        try:
            os.makedirs(GEN_DIR, exist_ok=True)
        except OSError as exc:
            sys.stderr.write("omarchy-touchbar: cannot create %s: %s\n" % (GEN_DIR, exc))

    def store(self, svg):
        digest = hashlib.sha1(svg.encode()).hexdigest()[:16]
        if digest not in self.known:
            try:
                with open(os.path.join(GEN_DIR, digest + ".svg"), "w") as handle:
                    handle.write(svg)
                self.known.add(digest)
            except OSError:
                return None
        return "gen/" + digest


