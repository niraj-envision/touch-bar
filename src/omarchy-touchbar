def spec(label, keys=None, fill="surface", fg="fg", size=26, gloss=True,
         badge=None, glow=False, **extra):
    out = {"label": label, "keys": keys, "fill": fill, "fg": fg,
           "size": size, "gloss": gloss, "badge": badge, "glow": glow}
    out.update(extra)
    return out


