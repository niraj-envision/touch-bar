def decompress_mozlz4(raw):
    """Decode Firefox/Zen's mozLz4 block format without another dependency."""
    if len(raw) < 12 or raw[:8] != b"mozLz40\0":
        raise ValueError("not a mozLz4 file")
    expected = struct.unpack("<I", raw[8:12])[0]
    data = raw[12:]
    out = bytearray()
    pos = 0
    while pos < len(data):
        token = data[pos]
        pos += 1
        literal_len = token >> 4
        if literal_len == 15:
            while pos < len(data):
                extra = data[pos]
                pos += 1
                literal_len += extra
                if extra != 255:
                    break
        if pos + literal_len > len(data):
            raise ValueError("truncated mozLz4 literals")
        out.extend(data[pos:pos + literal_len])
        pos += literal_len
        if pos == len(data):
            break
        if pos + 2 > len(data):
            raise ValueError("truncated mozLz4 offset")
        offset = data[pos] | (data[pos + 1] << 8)
        pos += 2
        if offset <= 0 or offset > len(out):
            raise ValueError("invalid mozLz4 offset")
        match_len = token & 0x0f
        if match_len == 15:
            while pos < len(data):
                extra = data[pos]
                pos += 1
                match_len += extra
                if extra != 255:
                    break
        match_len += 4
        start = len(out) - offset
        for index in range(match_len):
            out.append(out[start + index])
        if expected and len(out) > expected:
            raise ValueError("mozLz4 output exceeded declared size")
    if expected and len(out) != expected:
        raise ValueError("mozLz4 output size mismatch")
    return bytes(out)


def browser_title(title):
    return re.sub(r"\s+[—-]\s+(Zen Browser|Mozilla Firefox|Firefox)$", "",
                  str(title or ""), flags=re.I).strip()


def favicon_mime(data):
    if data.startswith(b"\x89PNG\r\n\x1a\n"):
        return "image/png"
    if data.startswith((b"GIF87a", b"GIF89a")):
        return "image/gif"
    if data.startswith(b"\xff\xd8\xff"):
        return "image/jpeg"
    if data.startswith(b"RIFF") and data[8:12] == b"WEBP":
        return "image/webp"
    if data[:4] == b"\x00\x00\x01\x00":
        return "image/x-icon"
    if b"<svg" in data[:512].lower():
        return "image/svg+xml"
    return None


class BrowserTabs:
    """Read live Firefox-family tabs and their local Places favicons."""

    def __init__(self):
        self.profile = self.find_profile()
        self.recovery = os.path.join(
            self.profile, "sessionstore-backups", "recovery.jsonlz4"
        ) if self.profile else None
        self.favicon_db = os.path.join(self.profile, "favicons.sqlite") \
            if self.profile else None
        self.stamp = None
        self.checked = 0.0
        self.tabs = []
        self.selected = 0
        self.signature = None
        self.icon_cache = {}
        self.icon_stamp = None
        self.session_cache = (None, None)   # (file stamp, parsed session)
        self.profile_checked = 0.0
        # The session file lags a Touch Bar tab tap by up to ~15s. Hold the
        # tapped selection until the file moves: (target, file's selection at
        # tap time, deadline).
        self.override = None
        self.file_selected = 0
        self.select_mods = self.load_select_chord()

    def load_select_chord(self):
        """The modifier that jumps straight to tab N. Firefox binds accel+N,
        but Zen rebinds it to Alt+N, so read the profile's actual shortcut
        table rather than assuming."""
        mods = "CTRL"
        if not self.profile:
            return mods
        path = os.path.join(self.profile, "zen-keyboard-shortcuts.json")
        try:
            with open(path) as handle:
                data = json.load(handle)
        except (OSError, ValueError):
            return mods
        entries = data if isinstance(data, list) else \
            (data.get("shortcuts") or [])
        for entry in entries:
            if not isinstance(entry, dict) or entry.get("id") != "key_selectTab1" \
                    or entry.get("disabled"):
                continue
            flags = entry.get("modifiers") or {}
            parts = []
            if flags.get("control") or flags.get("accel"):
                parts.append("CTRL")
            if flags.get("alt"):
                parts.append("ALT")
            if flags.get("shift"):
                parts.append("SHIFT")
            if flags.get("meta"):
                parts.append("SUPER")
            if parts:
                mods = "+".join(parts)
            break
        return mods

    @staticmethod
    def find_profile():
        roots = [os.path.join(HOME, ".config", "zen"),
                 os.path.join(HOME, ".mozilla", "firefox")]
        candidates = []
        for root in roots:
            ini_path = os.path.join(root, "profiles.ini")
            parser = configparser.ConfigParser()
            try:
                parser.read(ini_path)
            except (OSError, configparser.Error):
                parser = configparser.ConfigParser()
            for section in parser.sections():
                if not section.lower().startswith("profile"):
                    continue
                path = parser.get(section, "Path", fallback="")
                if not path:
                    continue
                if parser.getboolean(section, "IsRelative", fallback=True):
                    path = os.path.join(root, path)
                recovery = os.path.join(path, "sessionstore-backups",
                                        "recovery.jsonlz4")
                if os.path.isfile(recovery):
                    candidates.append((os.path.getmtime(recovery), path))
            for recovery in glob.glob(os.path.join(
                    root, "*", "sessionstore-backups", "recovery.jsonlz4")):
                candidates.append((os.path.getmtime(recovery),
                                   os.path.dirname(os.path.dirname(recovery))))
        return max(candidates)[1] if candidates else None

    @staticmethod
    def current_entry(tab):
        entries = tab.get("entries") or []
        if not entries:
            return {}
        index = max(0, min(len(entries) - 1, int(tab.get("index", 1)) - 1))
        return entries[index] or {}

    def choose_window(self, session, active_win):
        windows = session.get("windows") or []
        if not windows:
            return None
        wanted = browser_title((active_win or {}).get("title"))
        if wanted and wanted.lower() not in ("zen browser", "mozilla firefox", "firefox"):
            for window in windows:
                tabs = window.get("tabs") or []
                selected = max(0, min(len(tabs) - 1,
                                     int(window.get("selected", 1)) - 1))
                if tabs:
                    title = browser_title(self.current_entry(tabs[selected]).get("title"))
                    if title == wanted:
                        return window
        selected_window = max(0, int(session.get("selectedWindow", 1)) - 1)
        if selected_window < len(windows):
            return windows[selected_window]
        return max(windows, key=lambda item: item.get("zIndex", 0))

    def refresh(self, active_win=None, force=False):
        now = time.monotonic()
        if not force and now - self.checked < 0.35:
            return False
        self.checked = now
        if not self.recovery:
            # The browser may simply not have been running when the daemon
            # started; look for its profile again now and then.
            if now - self.profile_checked < 15.0:
                return False
            self.profile_checked = now
            self.profile = self.find_profile()
            if not self.profile:
                return False
            self.recovery = os.path.join(
                self.profile, "sessionstore-backups", "recovery.jsonlz4")
            self.favicon_db = os.path.join(self.profile, "favicons.sqlite")
            self.select_mods = self.load_select_chord()
        try:
            info = os.stat(self.recovery)
            stamp = (info.st_mtime_ns, info.st_size)
        except OSError:
            return False
        # A focus change between two Zen windows can select a different window
        # from an otherwise unchanged session file, so title is part of stamp.
        focus = browser_title((active_win or {}).get("title"))
        composite = stamp + (focus,)
        if not force and composite == self.stamp:
            return False
        cached_stamp, session = self.session_cache
        if cached_stamp != stamp:
            # Only decompress when the file itself changed; a mere focus or
            # title change re-picks the window from the parsed session.
            try:
                with open(self.recovery, "rb") as handle:
                    session = json.loads(decompress_mozlz4(handle.read()))
            except (OSError, ValueError, TypeError, json.JSONDecodeError) as exc:
                sys.stderr.write("omarchy-touchbar: cannot read browser tabs: %s\n" % exc)
                return False
            self.session_cache = (stamp, session)
        window = self.choose_window(session, active_win)
        if not window:
            return False
        all_tabs = window.get("tabs") or []
        selected_tab = max(0, min(len(all_tabs) - 1,
                                  int(window.get("selected", 1)) - 1))
        active_space = window.get("activeZenSpace")
        kept = []
        selected = 0
        for original, tab in enumerate(all_tabs):
            if tab.get("hidden"):
                continue
            workspace = tab.get("zenWorkspace")
            if active_space and workspace and workspace != active_space:
                continue
            entry = self.current_entry(tab)
            url = str(entry.get("url") or "")
            title = browser_title(entry.get("title")) or urllib.parse.urlsplit(url).hostname \
                or "New tab"
            if original == selected_tab:
                selected = len(kept)
            kept.append({"title": title, "url": url,
                         "image": tab.get("image") or tab.get("zenPinnedIcon")})
        self.file_selected = selected
        if self.override:
            target, at_tap, deadline = self.override
            if time.monotonic() > deadline or selected != at_tap:
                self.override = None     # the file caught up, or the user moved
            elif target < len(kept):
                selected = target
        new_signature = (selected, tuple((item["title"], item["url"])
                                         for item in kept))
        changed = new_signature != self.signature
        self.tabs = kept
        self.selected = min(selected, max(0, len(kept) - 1))
        self.signature = new_signature
        self.stamp = composite
        return changed

    def favicon(self, tab):
        image = tab.get("image")
        if isinstance(image, str) and image.startswith("data:image/") \
                and len(image) < 300000:
            return image
        url = tab.get("url") or ""
        if not url or not self.favicon_db:
            return None
        try:
            stamp = os.stat(self.favicon_db).st_mtime_ns
        except OSError:
            return None
        if stamp != self.icon_stamp:
            self.icon_stamp = stamp
            self.icon_cache.clear()
        if url in self.icon_cache:
            return self.icon_cache[url]
        data = None
        quoted = urllib.parse.quote(self.favicon_db)
        query = (
            "SELECT i.data FROM moz_pages_w_icons p "
            "JOIN moz_icons_to_pages x ON x.page_id=p.id "
            "JOIN moz_icons i ON i.id=x.icon_id "
            "WHERE p.page_url=? AND i.data IS NOT NULL "
            "ORDER BY CASE WHEN i.width BETWEEN 20 AND 64 THEN 0 ELSE 1 END, "
            "ABS(i.width-32) LIMIT 1"
        )
        try:
            db = sqlite3.connect("file:%s?mode=ro&immutable=1" % quoted,
                                 uri=True, timeout=0.05)
            row = db.execute(query, (url,)).fetchone()
            db.close()
            data = row[0] if row else None
        except sqlite3.Error:
            data = None
        result = None
        if data and len(data) < 300000:
            mime = favicon_mime(bytes(data))
            if mime:
                result = "data:%s;base64,%s" % (
                    mime, base64.b64encode(bytes(data)).decode("ascii"))
        if len(self.icon_cache) >= 256:      # icons are up to 300 KB each
            self.icon_cache.pop(next(iter(self.icon_cache)))
        self.icon_cache[url] = result
        return result


class Palette:
    """Named roles resolved against the current Omarchy theme."""

    def __init__(self, theme):
        self.theme = dict(FALLBACK_THEME)
        self.theme.update({k: v for k, v in theme.items() if isinstance(v, str)})
        get = self.theme.get
        self.roles = {
            "surface": get("lighter_background"),
            "sunken": get("darker_background"),
            "raised": get("selection"),
            "accent": get("accent"),
            "on_accent": get("dark_background"),
            "fg": get("foreground"),
            "muted": get("muted"),
        }

    def color(self, name, default="fg"):
        if not name:
            name = default
        if isinstance(name, str) and name.startswith("#"):
            return name
        return self.roles.get(name) or self.theme.get(name) or self.roles["fg"]


