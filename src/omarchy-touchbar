def emit(settings, rows):
    head = [
        "# Written by omarchy-touchbar. Edit ~/.config/omarchy/touchbar.toml instead.",
        "MediaLayerDefault = false",
        # Off, so the only grey rectangle tiny-dfr draws is the one behind a
        # button you are pressing - which shows as a halo around our pills.
        "ShowButtonOutlines = false",
        "EnablePixelShift = %s" % ("true" if settings["pixel_shift"] else "false"),
        "FontTemplate = %s" % toml_string(settings["font"] + ":bold"),
        "AdaptiveBrightness = %s" % ("true" if settings["adaptive_brightness"] else "false"),
        "ActiveBrightness = %d" % int(settings["active_brightness"]),
        "DoublePressSwitchLayers = 0",
        "",
        "PrimaryLayerKeys = [",
    ]
    return "\n".join(head + rows + ["]", "", MEDIA_LAYER])


