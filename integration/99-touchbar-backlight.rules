# Let the desktop session hold the Touch Bar backlight on while dictating or
# while Claude works. tiny-dfr blacks the panel out after 60s of no input.
ACTION=="add", SUBSYSTEM=="backlight", KERNEL=="appletb_backlight", \
  RUN+="/usr/bin/chgrp input /sys/class/backlight/appletb_backlight/brightness", \
  RUN+="/usr/bin/chmod g+w /sys/class/backlight/appletb_backlight/brightness"
